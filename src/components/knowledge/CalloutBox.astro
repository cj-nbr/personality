---
interface Props {
  type?: "info" | "warning" | "tip" | "example";
  title?: string;
}

const { type = "info", title } = Astro.props;
const typeStyles = {
  info: { border: "border-l-primary bg-primary/5 dark:border-l-primary dark:bg-primary/10", icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
  warning: { border: "border-l-warning bg-warning/5 dark:border-l-warning dark:bg-warning/10", icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" },
  tip: { border: "border-l-success bg-success/5 dark:border-l-success dark:bg-success/10", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  example: { border: "border-l-accent bg-accent/5 dark:border-l-accent dark:bg-accent/10", icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" },
};
const style = typeStyles[type];
---

<div class={`callout ${style.border} rounded-lg p-4 my-6 overflow-hidden`} role="note">
  <div class="flex items-start gap-3">
    <svg class="h-5 w-5 shrink-0 mt-0.5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={style.icon} />
    </svg>
    <div>
      {title && <h4 class="font-semibold text-ink dark:text-on-primary">{title}</h4>}
      <div class="mt-1 text-sm text-body dark:text-muted">
        <slot />
      </div>
    </div>
  </div>
</div>