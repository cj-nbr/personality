---
interface Props {
  title?: string;
  faqs: Array<{ question: string; answer: string }>;
}

const { title = "Frequently Asked Questions", faqs } = Astro.props;
---

<section class="mt-16 border-t border-hairline pt-12 dark:border-overlay-light" aria-labelledby="faqs-heading">
  <h2 id="faqs-heading" class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary">{title}</h2>
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group rounded-xl border border-hairline bg-canvas p-5 transition hover:border-primary focus-within:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
        <summary class="flex cursor-pointer list-none items-center justify-between text-left" aria-label={`Toggle answer for ${faq.question}`}>
          <h3 class="text-base font-semibold text-ink dark:text-on-primary">{faq.question}</h3>
          <svg class="h-5 w-5 shrink-0 text-ink transition-transform duration-200 group-open:rotate-180 dark:text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="mt-3 text-sm text-body dark:text-muted">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>