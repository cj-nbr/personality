---
interface Props {
  calculators: Array<{ title: string; href: string }>;
  title?: string;
}

const { calculators, title = "Related Calculators" } = Astro.props;
---

{calculators.length > 0 && (
  <section class="mt-6 border-t border-hairline pt-8 dark:border-overlay-light" aria-labelledby="related-calculators-heading">
    <h2 id="related-calculators-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">{title}</h2>
    <ul class="space-y-2">
      {calculators.map((calc) => (
        <li>
          <a href={calc.href} class="group flex items-center gap-2 text-sm text-link hover:underline dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {calc.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}