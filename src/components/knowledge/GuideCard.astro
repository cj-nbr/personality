---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  lastUpdated: string;
  readTime: string;
  featured?: boolean;
}

const { title, description, slug, category, lastUpdated, readTime, featured = false } = Astro.props;
---

<article class="card group dark:border-overlay-lighter dark:bg-surface">
  {featured && (
    <span class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary dark:bg-primary/20">Featured</span>
  )}
  <h3 class="mt-3 text-lg font-semibold text-ink group-hover:text-primary transition dark:text-on-primary">
    <a href={`/knowledge/${slug}`}>{title}</a>
  </h3>
  <p class="mt-2 text-sm text-body dark:text-muted line-clamp-3">{description}</p>
  <div class="mt-4 flex items-center gap-3 text-xs text-muted dark:text-muted">
    <span>{category}</span>
    <span aria-hidden="true">·</span>
    <span>{readTime}</span>
    <span aria-hidden="true">·</span>
    <time datetime={lastUpdated}>{lastUpdated}</time>
  </div>
</article>