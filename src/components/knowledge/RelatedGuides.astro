---
interface Props {
  guides: Array<{ title: string; slug: string; category: string }>;
  title?: string;
}

const { guides, title = "Related Guides" } = Astro.props;
---

{guides.length > 0 && (
  <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="related-guides-heading">
    <h2 id="related-guides-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">{title}</h2>
    <ul class="space-y-2">
      {guides.map((guide) => (
        <li>
          <a href={`/knowledge/${guide.slug}`} class="group flex items-center gap-2 text-sm text-link hover:underline dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            {guide.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}