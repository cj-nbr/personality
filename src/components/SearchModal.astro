---
import { buildSearchItems } from "../utils/search";
import { taxRules } from "../config/taxRules";
import { countries } from "../countries/index";
import { getCollection } from "astro:content";

const guides = await getCollection("guides");
const glossaryItems = await getCollection("glossary");

function mapCountries() {
  return countries.map((c) => {
    return { slug: c.slug, name: c.name, overview: c.overview };
  });
}

function mapGuides() {
  return guides.map((g) => {
    return { id: g.id, data: { title: g.data.title, description: g.data.description, category: g.data.category } };
  });
}

function mapGlossary() {
  return glossaryItems.map((g) => {
    return { id: g.id, data: { term: g.data.term, definition: g.data.definition, category: g.data.category } };
  });
}

const searchItems = buildSearchItems(
  taxRules,
  mapCountries(),
  mapGuides(),
  mapGlossary()
);
---

<script type="application/json" id="search-data" set:html={JSON.stringify(searchItems)} />

<div
  id="search-modal"
  class="hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div
    id="search-backdrop"
    class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm"
    aria-hidden="true"
  ></div>
  <div class="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] sm:pt-[15vh] px-4 sm:px-6">
    <div
      id="search-panel"
      class="w-full max-w-2xl bg-canvas dark:bg-surface rounded-xl border border-hairline dark:border-overlay-light shadow-2xl overflow-hidden flex flex-col max-h-[75vh] sm:max-h-[70vh]"
      role="search"
    >
      <div class="flex items-center gap-3 px-4 py-3 border-b border-hairline dark:border-overlay-light">
        <svg
          class="h-5 w-5 text-muted flex-shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <input
          id="search-input"
          type="text"
          class="flex-1 bg-transparent border-none outline-none text-ink dark:text-on-primary placeholder:text-muted text-base"
          placeholder="Search calculators, countries, guides..."
          autocomplete="off"
          aria-label="Search"
          aria-autocomplete="list"
          aria-controls="search-results-list"
          aria-activedescendant=""
        />
        <kbd
          class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-muted bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded-md"
        >
          ESC
        </kbd>
      </div>

      <div id="search-results" class="overflow-y-auto p-2">
        <div id="search-initial" class="py-8 text-center">
          <svg
            class="mx-auto h-10 w-10 text-muted opacity-40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <p class="mt-3 text-sm text-muted">
            Start typing to search across calculators, countries, guides, and
            glossary
          </p>
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            <span class="text-xs text-muted">Popular:</span>
            <button
              type="button"
              class="search-suggestion text-xs text-link hover:underline px-1"
              data-query="income tax"
            >
              income tax
            </button>
            <button
              type="button"
              class="search-suggestion text-xs text-link hover:underline px-1"
              data-query="india"
            >
              india
            </button>
            <button
              type="button"
              class="search-suggestion text-xs text-link hover:underline px-1"
              data-query="tax bracket"
            >
              tax bracket
            </button>
            <button
              type="button"
              class="search-suggestion text-xs text-link hover:underline px-1"
              data-query="gst"
            >
              gst
            </button>
          </div>
        </div>

        <ul
          id="search-results-list"
          class="hidden"
          role="listbox"
          aria-label="Search results"
        ></ul>

        <div id="search-empty" class="hidden py-8 text-center">
          <svg
            class="mx-auto h-10 w-10 text-muted opacity-40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <p class="mt-3 text-sm font-medium text-ink dark:text-on-primary">
            No results found
          </p>
          <p class="text-xs text-muted">Try a different search term</p>
        </div>
      </div>

      <div
        class="hidden sm:flex items-center justify-between px-4 py-2 border-t border-hairline dark:border-overlay-light text-xs text-muted"
      >
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1">
            <kbd
              class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-medium bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded"
            >
              ↑
            </kbd>
            <kbd
              class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-medium bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded"
            >
              ↓
            </kbd>
            to navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd
              class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-medium bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded"
            >
              ↵
            </kbd>
            to open
          </span>
          <span class="flex items-center gap-1">
            <kbd
              class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-medium bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded"
            >
              esc
            </kbd>
            to close
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var raw = document.getElementById('search-data');
    if (!raw) return;
    var searchItems = [];
    try { searchItems = JSON.parse(raw.textContent || '[]'); } catch(e) { return; }

    var modal = document.getElementById('search-modal');
    var backdrop = document.getElementById('search-backdrop');
    var input = document.getElementById('search-input');
    var resultsList = document.getElementById('search-results-list');
    var initial = document.getElementById('search-initial');
    var empty = document.getElementById('search-empty');

    var currentResults = [];
    var selectedIndex = -1;
    var isOpen = false;
    var lastFocusedElement = null;

    var focusableSelectors = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function highlightText(text, query) {
      if (!query) return escapeHtml(text);
      var escaped = escapeHtml(text);
      var terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      if (!terms.length) return escaped;
      var regex = new RegExp('(' + terms.map(function(t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|') + ')', 'gi');
      return escaped.replace(regex, '<mark class="search-highlight">$1</mark>');
    }

    function openModal() {
      if (isOpen) return;
      isOpen = true;
      lastFocusedElement = document.activeElement;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.value = '';
      currentResults = [];
      selectedIndex = -1;
      renderResults([], '');
      input.focus();
      announceToScreenReader('Search dialog opened');
      document.dispatchEvent(new CustomEvent('search:opened'));
    }

    function closeModal() {
      if (!isOpen) return;
      isOpen = false;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
      currentResults = [];
      selectedIndex = -1;
      renderResults([], '');
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }
      announceToScreenReader('Search dialog closed');
      document.dispatchEvent(new CustomEvent('search:closed'));
    }

    function announceToScreenReader(message) {
      var el = document.createElement('div');
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      el.setAttribute('aria-atomic', 'true');
      el.className = 'sr-only';
      el.textContent = message;
      document.body.appendChild(el);
      setTimeout(function() { document.body.removeChild(el); }, 1000);
    }

    function getCategoryIcon(category) {
      switch (category) {
        case 'Calculator':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>';
        case 'Country':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>';
        case 'Guide':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>';
        case 'Glossary':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>';
        default:
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>';
      }
    }

    function getCategoryColorClass(category) {
      switch (category) {
        case 'Calculator': return 'bg-primary/10 text-primary dark:text-link';
        case 'Country': return 'bg-success/10 text-success';
        case 'Guide': return 'bg-warning/10 text-warning';
        case 'Glossary': return 'bg-accent/10 text-accent dark:text-link';
        default: return 'bg-muted/10 text-muted';
      }
    }

    function search(query) {
      if (!query || query.trim().length === 0) {
        currentResults = [];
        selectedIndex = -1;
        renderResults([], '');
        return;
      }
      var q = query.toLowerCase().trim();
      var qTerms = q.split(/\s+/).filter(Boolean);
      var scored = [];
      for (var i = 0; i < searchItems.length; i++) {
        var item = searchItems[i];
        var titleLower = item.title.toLowerCase();
        var descLower = item.description.toLowerCase();
        var kwLower = (item.keywords || []).join(' ').toLowerCase();
        var score = Infinity;
        for (var t = 0; t < qTerms.length; t++) {
          var term = qTerms[t];
          var termScore = Infinity;
          if (titleLower === term) termScore = 0;
          else if (titleLower.startsWith(term)) termScore = 1;
          else if (titleLower.indexOf(term) !== -1) termScore = 2;
          else if (kwLower.indexOf(term) !== -1) termScore = 3;
          else if (descLower.indexOf(term) !== -1) termScore = 4;
          if (termScore < score) score = termScore;
        }
        if (score < Infinity) {
          scored.push({ item: item, score: score });
        }
      }
      scored.sort(function(a, b) { return a.score - b.score; });
      currentResults = scored.slice(0, 20).map(function(s) { return s.item; });
      selectedIndex = currentResults.length > 0 ? 0 : -1;
      renderResults(currentResults, query);
      if (currentResults.length > 0) {
        updateActiveDescendant();
      }
    }

    function renderResults(items, query) {
      if (items.length === 0 && query) {
        resultsList.classList.add('hidden');
        empty.classList.remove('hidden');
        initial.classList.add('hidden');
        return;
      }
      resultsList.classList.remove('hidden');
      empty.classList.add('hidden');
      initial.classList.add('hidden');
      resultsList.innerHTML = '';
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var li = document.createElement('li');
        li.className = 'search-result-item';
        li.setAttribute('role', 'option');
        li.setAttribute('id', 'search-result-' + i);
        li.setAttribute('aria-selected', i === selectedIndex ? 'true' : 'false');
        var a = document.createElement('a');
        a.href = item.url;
        a.setAttribute('tabindex', '-1');
        a.className = 'flex items-start gap-3 px-3 py-3 rounded-lg transition-colors ' + (i === selectedIndex ? 'bg-canvas-soft dark:bg-overlay-light' : 'hover:bg-canvas-soft dark:hover:bg-overlay-light');
        a.innerHTML =
          '<div class="flex-shrink-0 mt-0.5">' +
            '<span class="inline-flex items-center justify-center h-8 w-8 rounded-lg ' + getCategoryColorClass(item.category) + '">' +
              '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">' + getCategoryIcon(item.category) + '</svg>' +
            '</span>' +
          '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<div class="flex items-center gap-2">' +
              '<span class="text-sm font-medium text-ink dark:text-on-primary truncate">' + highlightText(item.title, query) + '</span>' +
              '<span class="search-result-badge inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider ' + getCategoryColorClass(item.category) + '">' + item.category + '</span>' +
            '</div>' +
            '<p class="mt-0.5 text-xs text-muted line-clamp-1">' + highlightText(item.description, query) + '</p>' +
          '</div>' +
          '<svg class="h-4 w-4 text-muted flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';
        li.appendChild(a);
        li.addEventListener('mouseenter', function() {
          var index = Array.from(resultsList.children).indexOf(li);
          selectedIndex = index;
          updateSelection();
        });
        a.addEventListener('click', function(e) {
          e.preventDefault();
          var index = Array.from(resultsList.children).indexOf(li);
          selectedIndex = index;
          selectCurrent();
        });
        resultsList.appendChild(li);
      }
    }

    function updateSelection() {
      var items = resultsList.querySelectorAll('.search-result-item');
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        if (i === selectedIndex) {
          item.classList.add('bg-canvas-soft', 'dark:bg-overlay-light');
          item.classList.remove('hover:bg-canvas-soft', 'dark:hover:bg-overlay-light');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-canvas-soft', 'dark:bg-overlay-light');
          item.classList.add('hover:bg-canvas-soft', 'dark:hover:bg-overlay-light');
          item.setAttribute('aria-selected', 'false');
        }
      }
      updateActiveDescendant();
    }

    function updateActiveDescendant() {
      if (selectedIndex >= 0 && selectedIndex < currentResults.length) {
        input.setAttribute('aria-activedescendant', 'search-result-' + selectedIndex);
      } else {
        input.setAttribute('aria-activedescendant', '');
      }
    }

    function selectCurrent() {
      if (selectedIndex >= 0 && selectedIndex < currentResults.length) {
        var item = currentResults[selectedIndex];
        window.location.href = item.url;
      }
    }

    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      var focusable = modal.querySelectorAll(focusableSelectors);
      if (focusable.length === 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function onKeyDown(e) {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          selectedIndex = (selectedIndex + 1) % currentResults.length;
          updateSelection();
        }
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
          updateSelection();
        }
        return;
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        selectCurrent();
        return;
      }
      if (e.key === 'Tab') {
        trapFocus(e);
        return;
      }
    }

    function onGlobalKeyDown(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) {
          closeModal();
        } else {
          openModal();
        }
      }
    }

    if (input) {
      input.addEventListener('input', function() {
        search(input.value);
      });
      input.addEventListener('keydown', onKeyDown);
    }

    if (backdrop) {
      backdrop.addEventListener('click', closeModal);
    }

    document.addEventListener('keydown', onGlobalKeyDown);
    document.addEventListener('keydown', function(e) {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        onKeyDown(e);
      }
    });

    document.querySelectorAll('.search-suggestion').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var q = btn.getAttribute('data-query');
        if (q && input) {
          input.value = q;
          search(q);
        }
      });
    });

    window.addEventListener('beforeunload', function() {
      document.removeEventListener('keydown', onGlobalKeyDown);
    });

    window.openSearchModal = openModal;
    window.closeSearchModal = closeModal;
  })();
</script>
