---
interface Props {
  searchData: Array<{
    type: string;
    title: string;
    description: string;
    href: string;
    category: string;
  }>;
}

const { searchData = [] } = Astro.props;
---

<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Search">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="search-overlay" aria-hidden="true"></div>
  <div class="fixed inset-x-4 top-[10vh] z-10 mx-auto max-w-2xl transform transition-all sm:top-[15vh]">
    <div class="rounded-2xl border border-hairline bg-canvas shadow-2xl dark:border-overlay-lighter dark:bg-surface">
      <div class="flex items-center gap-3 px-5 py-4 border-b border-hairline dark:border-overlay-light">
        <svg class="h-5 w-5 text-muted dark:text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="Search calculators, countries, guides, glossary..."
          aria-label="Search"
          aria-autocomplete="list"
          aria-controls="search-list"
          aria-expanded="true"
          role="combobox"
          class="flex-1 bg-transparent text-ink placeholder:text-muted focus:outline-none dark:text-on-primary dark:placeholder:text-muted"
          autocomplete="off"
        />
        <kbd class="hidden sm:inline-flex items-center gap-1 rounded-md border border-hairline px-2 py-0.5 text-xs font-medium text-muted dark:border-overlay-lighter dark:text-muted">
          <span class="text-xs">⌘</span><span class="text-xs">K</span>
        </kbd>
        <button id="search-close" class="rounded-lg p-1 text-muted hover:text-ink dark:hover:text-on-primary" aria-label="Close search">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto px-5 py-4" aria-live="polite" aria-atomic="true">
        <div id="search-loading" class="hidden py-8 text-center text-sm text-muted dark:text-muted">
          <svg class="mx-auto h-6 w-6 animate-spin text-primary" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
          </svg>
        </div>
        <div id="search-empty" class="hidden py-8 text-center" role="status">
          <svg class="mx-auto h-12 w-12 text-muted dark:text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">No results found</h3>
          <p class="mt-2 text-sm text-muted dark:text-muted">Try different keywords or browse our categories.</p>
        </div>
        <ul id="search-list" class="space-y-1" role="listbox" aria-label="Search results"></ul>
      </div>
      <div id="search-footer" class="flex items-center justify-between px-5 py-3 border-t border-hairline dark:border-overlay-light">
        <div class="flex items-center gap-4 text-xs text-muted dark:text-muted">
          <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-primary"></span> Calculators</span>
          <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-secondary"></span> Countries</span>
          <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-success"></span> Guides</span>
          <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-link"></span> Glossary</span>
        </div>
        <kbd class="hidden sm:inline-flex items-center gap-1 rounded-md border border-hairline px-2 py-0.5 text-xs font-medium text-muted dark:border-overlay-lighter dark:text-muted">
          <span class="text-xs">ESC</span> to close
        </kbd>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var modal = document.getElementById('search-modal');
    var overlay = document.getElementById('search-overlay');
    var input = document.getElementById('search-input');
    var resultsList = document.getElementById('search-list');
    var emptyState = document.getElementById('search-empty');
    var loadingState = document.getElementById('search-loading');
    var closeBtn = document.getElementById('search-close');
    var searchData = [];
    var selectedIndex = -1;
    var currentResults = [];

    function loadSearchData() {
      var script = document.getElementById('search-data');
      if (script && script.textContent) {
        try {
          return JSON.parse(script.textContent);
        } catch (e) {
          return [];
        }
      }
      return [];
    }

    searchData = loadSearchData();

    function openSearch() {
      if (!modal) return;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (input) {
        input.value = '';
        input.focus();
      }
      selectedIndex = -1;
      renderResults(searchData);
    }

    function closeSearch() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      selectedIndex = -1;
      currentResults = [];
    }

    function highlightText(text, query) {
      if (!query) return text;
      var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var regex = new RegExp('(' + escaped + ')', 'gi');
      return text.replace(regex, '<mark class="rounded px-0.5 bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary">$1</mark>');
    }

    function renderResults(data) {
      if (!resultsList) return;
      if (!emptyState) return;
      currentResults = data;

      if (data.length === 0) {
        resultsList.innerHTML = '';
        emptyState.classList.remove('hidden');
        loadingState && loadingState.classList.add('hidden');
        selectedIndex = -1;
        return;
      }

      emptyState.classList.add('hidden');
      loadingState && loadingState.classList.add('hidden');

      var grouped = {};
      data.forEach(function(item) {
        if (!grouped[item.type]) grouped[item.type] = [];
        grouped[item.type].push(item);
      });

      var html = '';
      var typeLabels = {
        calculator: 'Calculators',
        country: 'Countries',
        guide: 'Guides',
        glossary: 'Glossary'
      };
      var typeColors = {
        calculator: 'bg-primary',
        country: 'bg-secondary',
        guide: 'bg-success',
        glossary: 'bg-link'
      };

      Object.keys(grouped).forEach(function(type) {
        html += '<div class="mb-4">';
        html += '<h3 class="mb-2 px-1 text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted" aria-hidden="true">' + (typeLabels[type] || type) + '</h3>';
        grouped[type].forEach(function(item) {
          var globalIdx = data.indexOf(item);
          html += '<a href="' + item.href + '" class="group flex items-start gap-3 rounded-lg px-3 py-3 transition hover:bg-canvas-soft dark:hover:bg-surface/50" role="option" aria-selected="false" data-index="' + globalIdx + '" data-type="' + item.type + '">';
          html += '<span class="mt-1 inline-block h-2 w-2 rounded-full ' + (typeColors[item.type] || 'bg-primary') + ' flex-shrink-0" aria-hidden="true"></span>';
          html += '<div class="min-w-0 flex-1">';
          html += '<div class="text-sm font-medium text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">' + highlightText(item.title, input ? input.value.trim() : '') + '</div>';
          if (item.description) {
            html += '<div class="mt-0.5 text-xs text-muted line-clamp-1 dark:text-muted">' + highlightText(item.description, input ? input.value.trim() : '') + '</div>';
          }
          html += '<div class="mt-1 text-xs text-link dark:text-link">' + highlightText(item.category, input ? input.value.trim() : '') + '</div>';
          html += '</div>';
          html += '</a>';
        });
        html += '</div>';
      });

      resultsList.innerHTML = html;
      selectedIndex = -1;
      updateSelection();
    }

    function filterResults(query) {
      if (!query) {
        renderResults(searchData);
        return;
      }
      var q = query.toLowerCase().trim();
      var filtered = searchData.filter(function(item) {
        return item.title.toLowerCase().includes(q) ||
          item.description.toLowerCase().includes(q) ||
          item.category.toLowerCase().includes(q) ||
          item.type.toLowerCase().includes(q);
      });
      renderResults(filtered);
    }

    function updateSelection() {
      var items = resultsList ? resultsList.querySelectorAll('a[role="option"]') : [];
      items.forEach(function(el, idx) {
        if (idx === selectedIndex) {
          el.classList.add('bg-canvas-soft', 'dark:bg-surface/50');
          el.setAttribute('aria-selected', 'true');
        } else {
          el.classList.remove('bg-canvas-soft', 'dark:bg-surface/50');
          el.setAttribute('aria-selected', 'false');
        }
      });
    }

    function selectResult(index) {
      var items = resultsList ? resultsList.querySelectorAll('a[role="option"]') : [];
      if (index >= 0 && index < items.length) {
        items[index].click();
      }
    }

    function trapFocus(e) {
      if (e.key !== 'Tab' || !modal || modal.classList.contains('hidden')) return;
      var focusable = modal.querySelectorAll('button, input, a[href], [tabindex]:not([tabindex="-1"])');
      if (focusable.length === 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    if (modal && overlay) {
      overlay.addEventListener('click', closeSearch);
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSearch);
    }

    if (input) {
      input.addEventListener('input', function(e) {
        selectedIndex = -1;
        filterResults(e.target.value);
      });

      input.addEventListener('keydown', function(e) {
        var items = resultsList ? resultsList.querySelectorAll('a[role="option"]') : [];
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
          updateSelection();
          if (items[selectedIndex]) items[selectedIndex].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, 0);
          updateSelection();
          if (items[selectedIndex]) items[selectedIndex].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (selectedIndex >= 0 && items[selectedIndex]) {
            selectResult(selectedIndex);
          } else if (items.length > 0) {
            selectResult(0);
          }
        }
      });
    }

    if (resultsList) {
      resultsList.addEventListener('mousedown', function(e) {
        var anchor = e.target.closest('a[role="option"]');
        if (anchor) {
          var idx = parseInt(anchor.getAttribute('data-index') || '-1', 10);
          selectedIndex = idx;
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal && modal.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      }
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeSearch();
      }
      trapFocus(e);
    });

    var searchTrigger = document.getElementById('search-trigger');
    if (searchTrigger) {
      searchTrigger.addEventListener('click', openSearch);
    }

    var searchLink = document.getElementById('search-link');
    if (searchLink) {
      searchLink.addEventListener('click', function(e) {
        e.preventDefault();
        openSearch();
      });
    }
  })();
</script>
