---
interface Props {
  value: string;
  onInput: (value: string) => void;
  placeholder?: string;
}

const { value, onInput, placeholder = "" } = Astro.props;
---

<div class="relative" role="search">
  <label for="search-input" class="sr-only">{placeholder || "Search"}</label>
  <input
    id="search-input"
    type="search"
    value={value}
    oninput={(e) => onInput((e.target as HTMLInputElement).value)}
    placeholder={placeholder}
    aria-label={placeholder || "Search"}
    data-i18n-placeholder={placeholder || "common.search_placeholder"}
    class="w-full rounded-lg border border-hairline bg-canvas px-4 py-2.5 pl-10 text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-overlay-lighter dark:bg-surface dark:text-on-primary dark:placeholder:text-muted dark:focus:ring-primary/30 transition-colors duration-200"
  />
  <svg class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted dark:text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
</div>
