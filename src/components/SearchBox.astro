---
interface Props {
  value: string;
  onInput: (value: string) => void;
  placeholder?: string;
}

const { value, onInput, placeholder = "" } = Astro.props;
---

<div class="relative">
  <input
    type="text"
    role="searchbox"
    value={value}
    oninput={(e) => onInput((e.target as HTMLInputElement).value)}
    placeholder={placeholder}
    aria-label={placeholder || "Search"}
    data-i18n-placeholder={placeholder || "common.search_placeholder"}
    class="form-input pl-10"
  />
  <svg class="absolute left-3 top-1/2 h-5 w-5 text-muted -translate-y-1/2 dark:text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
</div>
