---
interface Props {
  country: {
    name: string;
    taxYear: string;
    filingDeadline: string;
    paymentDeadline: string;
    currency: string;
    officialTaxAuthority: string;
    taxAuthorityUrl: string;
    taxSystemDetails: {
      residentVsNonResident: string;
    };
    employerWithholding: string;
  };
}

const { country } = Astro.props;
---

<section class="country-section" aria-labelledby="tax-info-heading">
  <h2 id="tax-info-heading" class="section-title">Important Tax Information</h2>
  <p class="section-description mb-6">
    Key facts about {country.name}'s tax system to help you understand your obligations.
  </p>
  <div class="info-cards-grid">
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <h3 class="info-card-title">Tax Year</h3>
      <p class="info-card-text">{country.taxYear}</p>
    </div>
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      </div>
      <h3 class="info-card-title">Filing Deadline</h3>
      <p class="info-card-text">{country.filingDeadline}</p>
    </div>
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      </div>
      <h3 class="info-card-title">Tax Authority</h3>
      <p class="info-card-text">
        <a href={country.taxAuthorityUrl} target="_blank" rel="noopener noreferrer" class="text-link hover:underline dark:text-link">{country.officialTaxAuthority}</a>
      </p>
    </div>
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="info-card-title">Currency</h3>
      <p class="info-card-text">{country.currency}</p>
    </div>
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="info-card-title">Residency Rules</h3>
      <p class="info-card-text">{country.taxSystemDetails.residentVsNonResident}</p>
    </div>
    <div class="info-card">
      <div class="info-card-icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      </div>
      <h3 class="info-card-title">Employer Withholding</h3>
      <p class="info-card-text">{country.employerWithholding}</p>
    </div>
  </div>
  <div class="mt-6">
    <div class="callout callout-info">
      <p class="text-sm font-medium text-primary dark:text-link mb-1">Payment Deadline</p>
      <p class="text-sm text-body dark:text-muted">{country.paymentDeadline}</p>
    </div>
  </div>
</section>
