---
interface Props {
  country: {
    name: string;
    taxSystemDetails: {
      howTaxationWorks: string;
      whoPaysTax: string;
      residentVsNonResident: string;
      personalIncomeTax: string;
      businessTaxOverview: string;
      importantConcepts: Array<{ title: string; description: string }>;
    };
  };
}

const { country } = Astro.props;
---

<section class="country-section" aria-labelledby="overview-heading">
  <h2 id="overview-heading" class="section-title">How Taxation Works in {country.name}</h2>
  <p class="section-description mb-6">
    Understand the basics of {country.name}'s tax system, who pays tax, and how rates apply to individuals and businesses.
  </p>
  <div class="overview-grid">
    <div class="overview-card">
      <h3 class="overview-card-title">
        <svg class="w-5 h-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        Tax System
      </h3>
      <p class="overview-card-text">{country.taxSystemDetails.howTaxationWorks}</p>
    </div>
    <div class="overview-card">
      <h3 class="overview-card-title">
        <svg class="w-5 h-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Residents
      </h3>
      <p class="overview-card-text">{country.taxSystemDetails.whoPaysTax}</p>
    </div>
    <div class="overview-card">
      <h3 class="overview-card-title">
        <svg class="w-5 h-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Non-Residents
      </h3>
      <p class="overview-card-text">{country.taxSystemDetails.residentVsNonResident}</p>
    </div>
    <div class="overview-card">
      <h3 class="overview-card-title">
        <svg class="w-5 h-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Individuals
      </h3>
      <p class="overview-card-text">{country.taxSystemDetails.personalIncomeTax}</p>
    </div>
    <div class="overview-card">
      <h3 class="overview-card-title">
        <svg class="w-5 h-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        Businesses
      </h3>
      <p class="overview-card-text">{country.taxSystemDetails.businessTaxOverview}</p>
    </div>
  </div>
  {country.taxSystemDetails.importantConcepts.length > 0 && (
    <div class="concepts-grid mt-6">
      {country.taxSystemDetails.importantConcepts.map(concept => (
        <div class="concept-card">
          <h4 class="concept-title">{concept.title}</h4>
          <p class="concept-text">{concept.description}</p>
        </div>
      ))}
    </div>
  )}
</section>
