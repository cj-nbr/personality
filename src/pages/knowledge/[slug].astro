---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GuideTOC from "../../components/knowledge/GuideTOC.astro";
import RelatedGuides from "../../components/knowledge/RelatedGuides.astro";
import RelatedCalculators from "../../components/knowledge/RelatedCalculators.astro";
import RelatedCountryPages from "../../components/knowledge/RelatedCountryPages.astro";
import PrevNextNav from "../../components/knowledge/PrevNextNav.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map(guide => ({
    params: { slug: guide.id },
    props: { slug: guide.id },
  }));
}

const { slug } = Astro.props;
const guides = await getCollection("guides");
const guide = guides.find(g => g.id === slug);

if (!guide) {
  return Astro.redirect("/knowledge");
}

const { Content, headings } = await render(guide);

const allGuides = guides;
const currentIndex = allGuides.findIndex(g => g.id === slug);
const prev = currentIndex > 0 ? allGuides[currentIndex - 1] : null;
const next = currentIndex < allGuides.length - 1 ? allGuides[currentIndex + 1] : null;

const glossaryTerms = await getCollection("glossary");
const relatedGlossary = guide.data.relatedGlossary
  ? glossaryTerms.filter(t => guide.data.relatedGlossary.includes(t.id))
  : [];

const baseUrl = "https://finsiva.com";
const currentUrl = `${baseUrl}/knowledge/${guide.id}`;

const guideSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  url: currentUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": currentUrl },
  author: { "@type": "Organization", name: "Finsiva" },
  publisher: { "@type": "Organization", name: "Finsiva", logo: { "@type": "ImageObject", url: `${baseUrl}/logo.png` } },
  datePublished: "2026-01-01",
  dateModified: guide.data.lastUpdated,
  breadcrumb: {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl },
      { "@type": "ListItem", "position": 2, "name": "Knowledge Center", "item": `${baseUrl}/knowledge` },
      { "@type": "ListItem", "position": 3, "name": guide.data.title, "item": currentUrl }
    ]
  }
};
---

<Layout
  title={`${guide.data.title} | Finsiva Knowledge Center`}
  description={guide.data.description}
  canonical={currentUrl}
  robots="index,follow"
  schema={guideSchema}
  image="/og-image.svg"
  imageAlt={guide.data.title}
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Home", href: "/" },
        { label: "Knowledge Center", href: "/knowledge" },
        { label: guide.data.category, href: `/knowledge/category/${guide.data.category.toLowerCase().replace(/[\/\s]+/g, '-').replace(/-+/g, '-')}` },
        { label: guide.data.title }
      ]} />

      <header class="pt-8 pb-12">
        <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary dark:bg-primary/20">{guide.data.category}</span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink dark:text-on-primary sm:text-5xl">{guide.data.title}</h1>
        <p class="mt-4 text-xl text-body dark:text-muted">{guide.data.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-muted dark:text-muted">
          <time datetime={guide.data.lastUpdated}>Last updated: {guide.data.lastUpdated}</time>
          <span aria-hidden="true">·</span>
          <span>{guide.data.readTime} read</span>
        </div>
        {guide.data.author && (
          <div class="mt-4 flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-primary/10 dark:bg-on-primary/10 flex items-center justify-center">
              <svg class="h-5 w-5 text-primary dark:text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div>
              <p class="text-sm font-medium text-ink dark:text-on-primary">{guide.data.author}</p>
              <p class="text-xs text-muted dark:text-muted">{guide.data.authorBio || 'Finsiva Knowledge Team'}</p>
            </div>
          </div>
        )}
      </header>

      {guide.data.image && (
        <img src={guide.data.image} alt={guide.data.title} class="mb-8 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="eager" />
      )}

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">
        <aside class="lg:col-span-1" aria-label="Table of contents">
          <div class="sticky top-24">
            <GuideTOC items={headings.filter(h => h.depth >= 2 && h.depth <= 3).map(h => ({ id: h.slug, label: h.text, level: h.depth }))} />
          </div>
        </aside>

        <div class="lg:col-span-3 prose max-w-none prose-headings:mt-10 prose-headings:mb-4 prose-h2:text-2xl prose-h2:font-semibold prose-h2:text-ink dark:prose-h2:text-on-primary prose-h3:text-xl prose-h3:font-semibold prose-h3:text-ink dark:prose-h3:text-on-primary prose-p:text-body prose-p:leading-relaxed prose-p:mt-4 prose-a:text-link prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 prose-a:hover:text-primary prose-ul:list-disc prose-ul:pl-6 prose-ol:list-decimal prose-ol:pl-6 prose-li:mt-1 prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-primary/5 prose-blockquote:pl-4 prose-blockquote:py-2 prose-blockquote:italic prose-blockquote:text-body dark:prose-blockquote:bg-primary/10">
          <Content />
        </div>

        {guide.data.facts && (
          <div class="lg:col-span-3">
            <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Interesting Facts</h2>
            <ul class="list-disc pl-6 space-y-2 text-body dark:text-muted">
              {guide.data.facts.map((fact: string) => <li>{fact}</li>)}
            </ul>
          </div>
        )}

        {guide.data.quiz && (
          <div class="lg:col-span-3">
            <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Quick Quiz</h2>
            <div class="space-y-4">
              {guide.data.quiz.map((q: { question: string; options: string[] }, idx: number) => (
                <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
                  <p class="font-medium text-ink dark:text-on-primary">{idx + 1}. {q.question}</p>
                  <ul class="mt-2 list-disc pl-6 text-sm text-body dark:text-muted">
                    {q.options.map((opt: string) => <li>{opt}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}

        {guide.data.externalLinks && (
          <div class="lg:col-span-3">
            <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Further Reading</h2>
            <ul class="list-disc pl-6 space-y-2 text-body dark:text-muted">
              {guide.data.externalLinks.map((link: { title: string; url: string }) => (
                <li><a href={link.url} target="_blank" rel="noopener noreferrer" class="text-link hover:underline dark:text-link">{link.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {guide.data.relatedGuides && guide.data.relatedGuides.length > 0 && (
        <RelatedGuides guides={allGuides.filter(g => guide.data.relatedGuides.includes(g.id)).map(g => ({ title: g.data.title, slug: g.id, category: g.data.category }))} />
      )}

      {guide.data.relatedCalculators && guide.data.relatedCalculators.length > 0 && (
        <RelatedCalculators calculators={guide.data.relatedCalculators.map(c => ({ title: c, href: `/countries` }))} />
      )}

      {guide.data.relatedCountries && guide.data.relatedCountries.length > 0 && (
        <RelatedCountryPages countries={guide.data.relatedCountries.map(c => ({ name: c, slug: c.toLowerCase().replace(/\s+/g, '-') }))} />
      )}

      {relatedGlossary.length > 0 && (
        <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="related-glossary-heading">
          <h2 id="related-glossary-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Related Glossary Terms</h2>
          <ul class="space-y-2">
            {relatedGlossary.map(term => (
              <li>
                <a href={`/knowledge/glossary/${term.id}`} class="group flex items-center gap-2 text-sm text-link hover:underline dark:text-link">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                  {term.data.term}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="summary-heading">
        <h2 id="summary-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Summary</h2>
        <p class="text-body dark:text-muted">This guide has walked you through the essential aspects of <strong class="text-ink dark:text-on-primary">{guide.data.title}</strong>, from foundational definitions to practical application. You have learned how this concept fits into the broader tax system, what documentation is required, and how it affects your financial obligations. Whether you are filing your first return or optimizing a complex portfolio, the principles covered here provide a reliable framework for making informed decisions and maintaining compliance with tax authorities.</p>
        <p class="text-body dark:text-muted mt-4">Remember that tax law is dynamic. Rules, thresholds, and forms are updated regularly by legislatures and revenue agencies. Bookmark this guide and revisit it before each tax season to ensure your strategies remain current. Use our calculators to model your specific situation, and do not hesitate to consult a qualified tax professional for personalized advice.</p>
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="key-takeaways-heading">
        <h2 id="key-takeaways-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Key Takeaways</h2>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Understanding the precise definition of this term prevents costly errors in tax preparation and planning.</span>
          </li>
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Always cross-reference figures with original source documents such as W-2s, 1099s, or bank statements.</span>
          </li>
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Tax treatment varies significantly by jurisdiction; verify local rules before assuming they match international norms.</span>
          </li>
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Maintaining organized records throughout the year simplifies filing and strengthens your position during an audit.</span>
          </li>
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Consult a tax professional for cross-border income, business expenses, or unusual investment structures.</span>
          </li>
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Use our calculators and tools regularly to validate assumptions and explore the impact of legislative changes.</span>
          </li>
        </ul>
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="further-reading-heading">
        <h2 id="further-reading-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Further Reading</h2>
        <p class="text-body dark:text-muted mb-6">Deepen your understanding by exploring these related guides. Each one builds on the concepts introduced here and provides practical tools for real-world application.</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/knowledge/tax-brackets-explained" class="group rounded-lg border border-hairline p-4 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Brackets Explained</h3>
            <p class="mt-1 text-sm text-body dark:text-muted">Learn how progressive tax systems work and how brackets affect your effective rate.</p>
          </a>
          <a href="/knowledge/tax-deductions-explained" class="group rounded-lg border border-hairline p-4 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Deductions Explained</h3>
            <p class="mt-1 text-sm text-body dark:text-muted">Discover which deductions you qualify for and how to document them properly.</p>
          </a>
          <a href="/knowledge/tax-credits-explained" class="group rounded-lg border border-hairline p-4 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Credits Explained</h3>
            <p class="mt-1 text-sm text-body dark:text-muted">Understand refundable and non-refundable credits that can reduce your tax bill.</p>
          </a>
          <a href="/knowledge/capital-gains-tax-basics" class="group rounded-lg border border-hairline p-4 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Capital Gains Tax Basics</h3>
            <p class="mt-1 text-sm text-body dark:text-muted">Explore how investment profits are taxed and strategies to minimize gains tax.</p>
          </a>
        </div>
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="test-knowledge-heading">
        <h2 id="test-knowledge-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Test Your Knowledge</h2>
        <p class="text-body dark:text-muted mb-6">Answer these three questions to reinforce what you have learned. Check your understanding and revisit any sections that feel unclear.</p>
        <div class="space-y-6">
          <div class="rounded-lg border border-hairline bg-surface p-6 dark:border-overlay-lighter dark:bg-surface">
            <p class="font-medium text-ink dark:text-on-primary">1. What is the primary difference between a tax deduction and a tax credit?</p>
            <ul class="mt-3 space-y-2 list-disc pl-6 text-sm text-body dark:text-muted">
              <li>A deduction reduces taxable income, while a credit reduces tax owed dollar for dollar.</li>
              <li>A credit reduces taxable income, while a deduction reduces tax owed dollar for dollar.</li>
              <li>There is no difference; they are interchangeable terms.</li>
              <li>Deductions apply only to businesses, while credits apply only to individuals.</li>
            </ul>
          </div>
          <div class="rounded-lg border border-hairline bg-surface p-6 dark:border-overlay-lighter dark:bg-surface">
            <p class="font-medium text-ink dark:text-on-primary">2. Why is maintaining accurate records important for tax purposes?</p>
            <ul class="mt-3 space-y-2 list-disc pl-6 text-sm text-body dark:text-muted">
              <li>It ensures you can substantiate deductions and credits if your return is examined.</li>
              <li>It guarantees you will receive a larger refund regardless of your tax situation.</li>
              <li>It eliminates the need to file a tax return altogether.</li>
              <li>It automatically exempts you from estimated tax payments.</li>
            </ul>
          </div>
          <div class="rounded-lg border border-hairline bg-surface p-6 dark:border-overlay-lighter dark:bg-surface">
            <p class="font-medium text-ink dark:text-on-primary">3. How do tax brackets affect your effective tax rate?</p>
            <ul class="mt-3 space-y-2 list-disc pl-6 text-sm text-body dark:text-muted">
              <li>Your effective rate is typically lower than your marginal rate because only income above each threshold is taxed at the higher rate.</li>
              <li>Your effective rate equals your marginal rate because all income is taxed at the same percentage.</li>
              <li>Your effective rate is always higher than your marginal rate due to progressive taxation.</li>
              <li>Tax brackets have no effect on your effective rate; only deductions matter.</li>
            </ul>
          </div>
        </div>
      </section>

      <PrevNextNav prev={prev ? { title: prev.data.title, slug: prev.id } : undefined} next={next ? { title: next.data.title, slug: next.id } : undefined} />
    </div>
  </article>
</Layout>
