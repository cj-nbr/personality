---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PrevNextNav from "../../../components/knowledge/PrevNextNav.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const terms = await getCollection("glossary");
  return terms.map(term => ({
    params: { term: term.id },
    props: { slug: term.id },
  }));
}

const { slug } = Astro.props;
const glossary = await getCollection("glossary");
const term = glossary.find(t => t.id === slug);

if (!term) {
  return Astro.redirect("/knowledge/glossary");
}

const allGlossary = glossary;
const currentIndex = allGlossary.findIndex(t => t.id === slug);
const prev = currentIndex > 0 ? allGlossary[currentIndex - 1] : null;
const next = currentIndex < allGlossary.length - 1 ? allGlossary[currentIndex + 1] : null;

const baseUrl = "https://finsiva.com";
const currentUrl = `${baseUrl}/knowledge/glossary/${term.id}`;

const termSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.data.term,
  description: term.data.definition,
  url: currentUrl,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "Finsiva Tax Glossary",
    url: `${baseUrl}/knowledge/glossary`
  }
};
---

<Layout
  title={`${term.data.term} — Tax Glossary | Finsiva`}
  description={term.data.definition}
  canonical={currentUrl}
  robots="index,follow"
  schema={termSchema}
  image="/og-image.svg"
  imageAlt={`${term.data.term} definition — Finsiva Tax Glossary`}
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Home", href: "/" },
        { label: "Knowledge Center", href: "/knowledge" },
        { label: "Glossary", href: "/knowledge/glossary" },
        { label: term.data.term }
      ]} />

      <header class="pt-8 pb-12">
        <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary dark:bg-primary/20">{term.data.category}</span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink dark:text-on-primary">{term.data.term}</h1>
        {term.data.pronunciation && (
          <p class="mt-2 text-lg text-muted dark:text-muted italic">{term.data.pronunciation}</p>
        )}
      </header>

      <img src="https://images.unsplash.com/photo-zfHiLYHM4Tk?w=1200&q=80" alt={`Visual guide and reference for ${term.data.term}`} class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />

      <section class="prose max-w-none prose-p:text-body prose-p:leading-relaxed prose-p:mt-4 prose-a:text-link prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 prose-a:hover:text-primary" aria-labelledby="definition-heading">
        <h2 id="definition-heading" class="text-2xl font-semibold text-ink dark:text-on-primary">Definition</h2>
        <p class="mt-2 text-xl text-ink dark:text-on-primary font-medium leading-relaxed">{term.data.definition}</p>
        <p class="mt-4 text-body dark:text-muted">This term is commonly used in tax preparation and financial planning. Understanding its precise meaning helps you interpret tax forms, evaluate deductions, and communicate effectively with tax professionals.</p>

        {term.data.examples && term.data.examples.length > 0 && (
          <>
            <h3 class="text-xl font-semibold text-ink mt-8 dark:text-on-primary">Examples</h3>
            <ul class="mt-4 space-y-3">
              {term.data.examples.map(ex => (
                <li class="flex items-start gap-3 text-body">
                  <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>{ex}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {term.data.relatedGuides && term.data.relatedGuides.length > 0 && (
          <section class="mt-10" aria-labelledby="related-guides-heading">
            <h3 id="related-guides-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Related Guides</h3>
            <ul class="space-y-2">
              {term.data.relatedGuides.map(rel => (
                <li>
                  <a href={`/knowledge/${rel}`} class="text-link hover:underline dark:text-link">{rel}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {term.data.relatedCalculators && term.data.relatedCalculators.length > 0 && (
          <section class="mt-6" aria-labelledby="related-calcs-heading">
            <h3 id="related-calcs-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Related Calculators</h3>
            <ul class="space-y-2">
              {term.data.relatedCalculators.map(rel => (
                <li>
                  <a href={`/countries`} class="text-link hover:underline dark:text-link">{rel}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {term.data.relatedGlossary && term.data.relatedGlossary.length > 0 && (
          <section class="mt-6" aria-labelledby="related-glossary-heading">
            <h3 id="related-glossary-heading" class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">See Also</h3>
            <ul class="space-y-2">
              {term.data.relatedGlossary.map(rel => (
                <li>
                  <a href={`/knowledge/glossary/${rel}`} class="text-link hover:underline dark:text-link">{rel}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="related-terms-heading">
        <h2 id="related-terms-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Related Terms</h2>
        <p class="text-body dark:text-muted mb-6">Understanding how this term connects to other vocabulary strengthens your ability to read tax documents and communicate precisely with professionals.</p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/knowledge/glossary/taxable-income" class="group flex items-center gap-2 rounded-md border border-hairline p-3 text-sm text-link hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-medium text-ink dark:text-on-primary">Taxable Income</span>
          </a>
          <a href="/knowledge/glossary/tax-credit" class="group flex items-center gap-2 rounded-md border border-hairline p-3 text-sm text-link hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-medium text-ink dark:text-on-primary">Tax Credit</span>
          </a>
          <a href="/knowledge/glossary/tax-deduction" class="group flex items-center gap-2 rounded-md border border-hairline p-3 text-sm text-link hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-medium text-ink dark:text-on-primary">Tax Deduction</span>
          </a>
          <a href="/knowledge/glossary/withholding" class="group flex items-center gap-2 rounded-md border border-hairline p-3 text-sm text-link hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-medium text-ink dark:text-on-primary">Withholding</span>
          </a>
          <a href="/knowledge/glossary/effective-tax-rate" class="group flex items-center gap-2 rounded-md border border-hairline p-3 text-sm text-link hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary dark:text-link">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-medium text-ink dark:text-on-primary">Effective Tax Rate</span>
          </a>
        </div>
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="practical-application-heading">
        <h2 id="practical-application-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Practical Application</h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <p class="text-body dark:text-muted mb-4">In practice, this term appears on nearly every major tax form. For individuals, it shows up on Form {term.data.term ? '1040' : 'W-2'} when reporting wages, on Schedule C for business income, and on Schedule D for capital gains. Businesses encounter it on corporate returns, partnership statements, and payroll filings. Knowing exactly where to place the information prevents costly rework and ensures accurate computation of tax owed.</p>
            <p class="text-body dark:text-muted mb-4">When preparing your return, cross-reference the figures entered in this field with supporting documents such as W-2s, 1099s, bank statements, and receipts. A single transposition error can cascade into incorrect deductions, credits, or estimated payments. Use our calculators to validate your numbers before submitting, and consider filing electronically for immediate confirmation of receipt.</p>
            <p class="text-body dark:text-muted">If you are self-employed, maintain a separate ledger for this category of income and expenses. Record each transaction with date, counterparty, amount, and purpose. At year end, reconcile your ledger against bank statements and third-party reports such as 1099-K or 1099-NEC to catch discrepancies before the IRS or local authority contacts you.</p>
          </div>
          <div class="rounded-lg border border-hairline bg-surface p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-on-primary">Real-World Example</h3>
            <p class="text-body dark:text-muted mb-3">Consider a freelance graphic designer who earned $75,000 in client payments during the year. Of that amount, $12,000 came from a foreign client and was subject to withholding in that country. The designer must report the full $75,000 on their home country return, claim a foreign tax credit for the $12,000 withheld, and pay any remaining balance. Understanding the precise definition and documentation requirements for this term ensures the credit is calculated correctly and the return is not flagged for review.</p>
            <p class="text-body dark:text-muted">Another example involves a rental property owner who received $24,000 in gross rent. After deducting $8,000 in mortgage interest, $3,000 in property taxes, and $2,000 in maintenance, the net amount reported reflects the true economic gain. Accurate classification prevents overpayment and supports the position if the tax authority questions the return.</p>
          </div>
        </div>
      </section>

      <section class="mt-12 border-t border-hairline pt-10 dark:border-overlay-light" aria-labelledby="country-variations-heading">
        <h2 id="country-variations-heading" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Country Variations</h2>
        <p class="text-body dark:text-muted mb-6">While the core concept of this term is consistent across jurisdictions, the rules and thresholds vary significantly. Understanding these differences is essential for expatriates, digital nomads, and businesses operating in multiple countries.</p>
        <div class="space-y-6">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="rounded-lg border border-hairline bg-surface p-5 dark:border-overlay-lighter dark:bg-surface">
              <h3 class="font-semibold text-ink dark:text-on-primary">United States</h3>
              <p class="mt-2 text-sm text-body dark:text-muted">The IRS defines and governs this concept through a comprehensive body of regulations, court rulings, and revenue procedures. Thresholds are adjusted annually for inflation, and specific industries may have special rules under the Internal Revenue Code.</p>
            </div>
            <div class="rounded-lg border border-hairline bg-surface p-5 dark:border-overlay-lighter dark:bg-surface">
              <h3 class="font-semibold text-ink dark:text-on-primary">United Kingdom</h3>
              <p class="mt-2 text-sm text-body dark:text-muted">HMRC applies similar principles but with distinct terminology and calculation methods. Reliefs such as the personal allowance interact with this concept in ways that differ from the US standard deduction approach.</p>
            </div>
            <div class="rounded-lg border border-hairline bg-surface p-5 dark:border-overlay-lighter dark:bg-surface">
              <h3 class="font-semibold text-ink dark:text-on-primary">India</h3>
              <p class="mt-2 text-sm text-body dark:text-muted">The Income Tax Act includes specific provisions for residential status, which determines whether global income is taxable in India or only Indian-sourced income. This creates a different framework for individuals with cross-border ties.</p>
            </div>
            <div class="rounded-lg border border-hairline bg-surface p-5 dark:border-overlay-lighter dark:bg-surface">
              <h3 class="font-semibold text-ink dark:text-on-primary">Singapore</h3>
              <p class="mt-2 text-sm text-body dark:text-muted">IRAS offers various exemptions and rebates that effectively reduce the final liability. The concept is applied alongside territorial tax principles, meaning foreign-sourced income is generally exempt unless remitted.</p>
            </div>
          </div>
          <p class="text-body dark:text-muted">Always verify the current rules with the official tax authority of the relevant country or consult a cross-border tax specialist, as bilateral tax treaties and local legislation may affect the treatment of this term in your specific case.</p>
        </div>
      </section>

      <PrevNextNav
        prev={prev ? { title: prev.data.term, slug: `glossary/${prev.id}` } : undefined}
        next={next ? { title: next.data.term, slug: `glossary/${next.id}` } : undefined}
      />
    </div>
  </article>
</Layout>