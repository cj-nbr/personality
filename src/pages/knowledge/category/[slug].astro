---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GuideCard from "../../../components/knowledge/GuideCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  const categories = [...new Set(guides.map(g => g.data.category))];
  return categories.map(cat => ({
    params: { slug: cat.toLowerCase().replace(/[\/\s]+/g, '-').replace(/-+/g, '-') },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const guides = await getCollection("guides");
const categoryGuides = guides.filter(g => g.data.category === category);

if (categoryGuides.length === 0) {
  return Astro.redirect("/knowledge");
}

const baseUrl = "https://finsiva.com";
---

<Layout
  title={`${category} Guides | Finsiva Knowledge Center`}
  description={`Explore our collection of educational guides on ${category}. Clear, expert-written explanations to help you understand tax concepts.`}
  canonical={`${baseUrl}/knowledge/category/${category.toLowerCase().replace(/\s+/g, '-')}`}
  robots="index,follow"
  image="/og-image.svg"
  imageAlt={`${category} guides — Finsiva Knowledge Center`}
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Home", href: "/" },
        { label: "Knowledge Center", href: "/knowledge" },
        { label: category }
      ]} />

      <header class="pt-8 pb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-ink dark:text-on-primary sm:text-5xl">{category} Guides</h1>
        <p class="mt-4 text-xl text-body dark:text-muted">{categoryGuides.length} comprehensive guide{categoryGuides.length !== 1 ? 's' : ''} to help you understand {category.toLowerCase()} concepts. Understanding this area is essential for accurate tax filing, maximizing deductions, and avoiding costly mistakes.</p>
      </header>

      <img src="https://images.unsplash.com/photo-cUt0MWZOlfY?w=1200&q=80" alt={`${category} educational resources and guides`} class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {categoryGuides.map(guide => (
          <GuideCard title={guide.data.title} description={guide.data.description} slug={guide.id} category={guide.data.category} lastUpdated={guide.data.lastUpdated} readTime={guide.data.readTime} featured={guide.data.featured} />
        ))}
      </div>

      <section class="mt-16 border-t border-hairline pt-12 dark:border-overlay-light" aria-labelledby="why-category-matters-heading">
        <h2 id="why-category-matters-heading" class="text-3xl font-semibold text-ink mb-6 dark:text-on-primary">Why This Category Matters</h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <p class="text-body dark:text-muted mb-4">Understanding <strong class="text-ink dark:text-on-primary">{category}</strong> is fundamental to making informed financial decisions and staying compliant with tax regulations. Whether you are an individual taxpayer, a small business owner, or a financial advisor, the concepts covered in this category directly impact your bottom line and long-term planning strategy.</p>
            <p class="text-body dark:text-muted mb-4">Tax rules in this area are frequently updated by revenue authorities, and small changes can have significant effects on your liability or refund. By building a solid foundation in these principles, you position yourself to adapt quickly to new legislation, identify legitimate savings opportunities, and avoid costly penalties that arise from misunderstanding or non-compliance.</p>
            <p class="text-body dark:text-muted">Our guides are written by tax professionals and reviewed annually to ensure accuracy. They break down complex regulations into actionable insights you can apply immediately to your personal or business situation.</p>
          </div>
          <div class="rounded-lg border border-hairline bg-surface p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Who Benefits From This Category?</h3>
            <ul class="space-y-3 text-sm text-body dark:text-muted">
              <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>Individual taxpayers seeking to maximize deductions and credits</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>Small business owners managing payroll and corporate obligations</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>Freelancers and gig workers navigating self-employment tax</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>Financial planners advising clients on tax-efficient strategies</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>Students and professionals preparing for tax certification exams</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-hairline pt-12 dark:border-overlay-light" aria-labelledby="key-concepts-heading">
        <h2 id="key-concepts-heading" class="text-3xl font-semibold text-ink mb-6 dark:text-on-primary">Key Concepts</h2>
        <p class="text-body dark:text-muted mb-6">Mastering these foundational ideas will help you navigate the rest of our guides with confidence and apply what you learn to real-world scenarios.</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Taxable Income</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">The portion of your income subject to tax after allowable deductions and exemptions have been applied.</p>
          </div>
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Tax Brackets</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Income ranges that are taxed at specific rates, typically structured progressively so higher income is taxed at higher rates.</p>
          </div>
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Deductions vs Credits</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Deductions reduce taxable income, while credits directly reduce tax owed. Credits are generally more valuable because they reduce tax dollar for dollar.</p>
          </div>
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Filing Status</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Your marital and household situation, which determines applicable tax rates, standard deductions, and eligibility for certain credits.</p>
          </div>
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Withholding</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">The system by which employers deduct tax from wages and remit it to the tax authority on behalf of employees.</p>
          </div>
          <div class="card rounded-lg border border-hairline p-5 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Record Keeping</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Maintaining organized documentation of income, expenses, and supporting receipts to substantiate tax positions and survive audits.</p>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-hairline pt-12 dark:border-overlay-light" aria-labelledby="how-to-apply-heading">
        <h2 id="how-to-apply-heading" class="text-3xl font-semibold text-ink mb-6 dark:text-on-primary">How to Apply This Knowledge</h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <p class="text-body dark:text-muted mb-4">Start by reviewing the guides in this category and identifying the topics most relevant to your situation. Use our interactive calculators to model different scenarios and see how changes in income, deductions, or credits affect your tax liability. Each guide includes step-by-step instructions, real-world examples, and links to the official guidance from tax authorities.</p>
            <p class="text-body dark:text-muted mb-4">As you read, take notes on the rules that apply to you and create a checklist of documents you need to gather before filing. Compare your situation against the examples provided, and do not hesitate to consult a qualified tax professional for complex matters such as cross-border income, business expenses, or investment gains.</p>
            <p class="text-body dark:text-muted">Finally, revisit these guides before each tax season. Tax laws change frequently, and staying current ensures you take advantage of new provisions and avoid surprises at filing time. Bookmark our glossary for quick reference to unfamiliar terms, and explore related calculators to put theory into practice.</p>
          </div>
          <div class="lg:col-span-1">
            <div class="rounded-lg border border-hairline bg-primary/5 p-6 dark:border-overlay-lighter dark:bg-surface">
              <h3 class="text-lg font-semibold text-ink mb-3 dark:text-on-primary">Quick Action Steps</h3>
              <ol class="space-y-3 text-sm text-body dark:text-muted list-decimal list-inside">
                <li>Identify which guides in this category match your tax situation.</li>
                <li>Run the relevant calculators with your actual numbers.</li>
                <li>Download or print the worksheets provided in each guide.</li>
                <li>Schedule a review with a tax professional if your situation is complex.</li>
                <li>Set a calendar reminder to review updates before the next filing deadline.</li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-hairline pt-12 dark:border-overlay-light" aria-labelledby="related-categories-heading">
        <h2 id="related-categories-heading" class="text-3xl font-semibold text-ink mb-6 dark:text-on-primary">Related Categories</h2>
        <p class="text-body dark:text-muted mb-6">Tax topics often overlap. Exploring these related categories will give you a more complete picture of your obligations and opportunities.</p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          <a href="/knowledge/category/Tax%20Basics" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Basics</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Foundational concepts including filing status, taxable income definitions, and standard versus itemized deductions. Essential reading for anyone new to tax preparation.</p>
          </a>
          <a href="/knowledge/category/Tax%20Planning" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Planning</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Strategic approaches to minimizing tax liability throughout the year, including timing of income and expenses, retirement contributions, and investment selection.</p>
          </a>
          <a href="/knowledge/category/Tax%20Filing" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Filing</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Step-by-step guidance through the filing process, including forms selection, electronic submission, and what to do after you file.</p>
          </a>
          <a href="/knowledge/category/Deductions" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Deductions</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Deep dives into above-the-line and itemized deductions, documentation requirements, and audit-proofing your deduction claims.</p>
          </a>
          <a href="/knowledge/category/Tax%20Credits" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Tax Credits</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Refundable and non-refundable credits that reduce your tax bill, including education, energy, and child-related credits available in many jurisdictions.</p>
          </a>
          <a href="/knowledge/category/Self-Employment" class="group rounded-lg border border-hairline p-5 transition-colors hover:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="font-semibold text-ink group-hover:text-primary dark:text-on-primary dark:group-hover:text-primary">Self-Employment</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Special tax rules for freelancers, contractors, and sole proprietors, including estimated taxes, self-employment tax, and home office deductions.</p>
          </a>
        </div>
      </section>
    </div>
  </article>
</Layout>