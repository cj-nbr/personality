const title = "Hong Kong Income Tax Guide 2026: Salaries, Profits & Property Tax";
const description = "Complete guide to Hong Kong income tax for individuals and businesses. Learn salaries tax rates (2%-17%), profits tax (8.25%-16.5%), property tax, and tax calculations for expats and foreigners.";
