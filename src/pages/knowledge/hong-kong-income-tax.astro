const currentUrl = `${baseUrl}/knowledge/hong-kong-income-tax`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the Hong Kong income tax rate for individuals in 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Hong Kong salaries tax rates for individuals range from 2% to 17% under the progressive system, or 15% under the standard rate - whichever is lower. The basic allowance is HK$132,000 per person for 2026."
      }
    },
    {
      "@type": "Question",
      name: "How much is corporate tax in Hong Kong?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Corporate tax in Hong Kong is 8.25% on the first HK$2 million of assessable profits and 16.5% on profits exceeding HK$2 million. Unincorporated businesses pay 7.5% and 15% respectively."
      }
    },
    {
      "@type": "Question",
      name: "Is Hong Kong income tax for foreigners high?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Hong Kong income tax for foreigners is typically low due to the territorial tax system. Only income sourced in Hong Kong is taxable, and overseas income is generally exempt."
      }
    },
    {
      "@type": "Question",
      name: "How do I calculate Hong Kong salaries tax?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use our Hong Kong salaries tax calculator or follow the progressive tax brackets from 2% to 17% on net chargeable income after deducting MPF contributions and personal allowances."
      }
    },
    {
      "@type": "Question",
      name: "What is the Hong Kong tax bracket for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Hong Kong progressive tax brackets for 2026: HK$50,000 at 2%, next HK$50,000 at 6%, next HK$40,000 at 10%, next HK$40,000 at 14%, and above HK$200,000 at 17%."
      }
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Hong Kong Income Tax Guide 2026: Salaries, Profits & Property Tax",
  description: "Complete guide to Hong Kong income tax for individuals and businesses. Learn all tax rates, brackets, deductions and how to calculate your tax liability.",
  url: currentUrl,
  author: { "@type": "Organization", name: "Finsiva" },
  dateModified: "2026-08-08"
};
