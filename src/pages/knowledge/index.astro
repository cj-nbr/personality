---
import Layout from "../../layouts/Layout.astro";
import KnowledgeHero from "../../components/knowledge/KnowledgeHero.astro";
import CategoryBrowser from "../../components/knowledge/CategoryBrowser.astro";
import GuideCard from "../../components/knowledge/GuideCard.astro";
import { getCollection } from "astro:content";

const guides = await getCollection("guides");
const categories = [
   { name: "Income Tax", slug: "income-tax", count: guides.filter(g => g.data.category === "Income Tax").length, description: "Learn about income tax basics, rates, and how your taxable income is calculated." },
   { name: "Tax Deductions", slug: "tax-deductions", count: guides.filter(g => g.data.category === "Tax Deductions").length, description: "Explore deductions that reduce your taxable income and lower your tax bill." },
   { name: "Tax Credits", slug: "tax-credits", count: guides.filter(g => g.data.category === "Tax Credits").length, description: "Learn about tax credits that directly reduce your tax liability." },
   { name: "Payroll Taxes", slug: "payroll-taxes", count: guides.filter(g => g.data.category === "Payroll Taxes").length, description: "Understand Social Security, Medicare, and employer payroll tax obligations." },
   { name: "Capital Gains", slug: "capital-gains", count: guides.filter(g => g.data.category === "Capital Gains").length, description: "Learn about tax on investment gains, short-term vs long-term holding periods." },
   { name: "GST / VAT", slug: "gst-vat", count: guides.filter(g => g.data.category === "GST / VAT").length, description: "Understand goods and services tax and value-added tax systems." },
   { name: "Tax Residency", slug: "tax-residency", count: guides.filter(g => g.data.category === "Tax Residency").length, description: "Understand tax residency rules that determine which country taxes your income." },
   { name: "Tax Planning", slug: "tax-planning", count: guides.filter(g => g.data.category === "Tax Planning").length, description: "Strategies and principles for lawful tax optimization and financial planning." },
   { name: "Hong Kong Income Tax", slug: "hong-kong-income-tax", count: 1, description: "Complete guide to Hong Kong income tax for individuals, businesses, and expatriates." },
];

const featuredGuides = guides.filter(g => g.data.featured).slice(0, 3);
const popularGuides = guides.sort((a, b) => b.data.readTime.localeCompare(a.data.readTime)).slice(0, 4);
const recentGuides = guides.sort((a, b) => new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime()).slice(0, 4);

const baseUrl = "https://finsiva.com";

const knowledgeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Tax Knowledge Center | Finsiva",
  description: "Explore our comprehensive tax knowledge center with guides, glossaries, and educational resources on global tax topics.",
  url: `${baseUrl}/knowledge`,
  isPartOf: { "@type": "WebSite", "name": "Finsiva", "url": baseUrl },
  breadcrumb: { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl }, { "@type": "ListItem", "position": 2, "name": "Knowledge Center", "item": `${baseUrl}/knowledge` }] }
};
---

<Layout
  title="Tax Knowledge Center | Guides, Glossary & Learning Resources | Finsiva"
  description="Explore the Finsiva Knowledge Center — comprehensive guides on income tax, deductions, credits, capital gains, payroll taxes, and more. Learn tax concepts with clear explanations and examples."
  canonical={`${baseUrl}/knowledge`}
  robots="index,follow"
  schema={knowledgeSchema}
  image="/og-image.svg"
  imageAlt="Finsiva Tax Knowledge Center — guides, glossary, and educational resources"
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
      <KnowledgeHero
       title="Tax Knowledge Center"
       subtitle="Learn & Understand"
       description="Master tax concepts with expert-written guides, a searchable glossary, and clear explanations. From income tax basics to international tax planning — everything you need to understand how taxes work."
       ctaLabel="Browse Guides"
       ctaHref="/knowledge"
       secondaryLabel="Tax Glossary"
       secondaryHref="/knowledge/glossary"
       />
      <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=1200&q=80" alt="Person reviewing financial documents and tax planning materials" class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />

      <section class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="intro-heading">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
          <h2 id="intro-heading" class="text-3xl font-semibold text-ink mb-8 dark:text-on-primary">Why Tax Education Matters</h2>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-4">
            Taxes affect nearly every financial decision you make, from choosing a job offer and buying a home to investing in stocks or starting a business. Yet tax education is rarely taught in schools, leaving many people to learn through costly mistakes, intimidating forms, or last-minute scrambles during filing season.
          </p>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-4">
            The Finsiva Knowledge Center was created to close that gap. We break down complex tax topics into clear, structured guides that anyone can understand, regardless of their background in finance or accounting. Our goal is not just to help you file taxes, but to help you think strategically about how taxes shape your financial life.
          </p>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-4">
            Whether you are a student learning about payroll deductions for the first time, a freelancer navigating quarterly estimated payments, or an expatriate trying to understand double-taxation agreements, our guides are organized to meet you where you are and help you progress at your own pace.
          </p>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl">
            We believe that informed taxpayers are empowered taxpayers. By understanding the why behind tax rules, you can spot opportunities for legitimate savings, avoid common pitfalls, and communicate more effectively with tax professionals when complex situations arise.
          </p>
        </div>
      </section>

      <section class="border-t border-hairline dark:border-overlay-light" aria-labelledby="featured-heading">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
          <h2 id="featured-heading" class="text-3xl font-semibold text-ink mb-8 dark:text-on-primary">Featured Guides</h2>
         <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
         {featuredGuides.map(guide => (
           <GuideCard title={guide.data.title} description={guide.data.description} slug={guide.id} category={guide.data.category} lastUpdated={guide.data.lastUpdated} readTime={guide.data.readTime} featured={true} />
         ))}
         </div>
       </div>
     </section>

     <CategoryBrowser categories={categories} />

     <section class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="popular-heading">
       <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
         <h2 id="popular-heading" class="text-3xl font-semibold text-ink mb-8 dark:text-on-primary">Popular Articles</h2>
         <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
         {popularGuides.map(guide => (
           <GuideCard title={guide.data.title} description={guide.data.description} slug={guide.id} category={guide.data.category} lastUpdated={guide.data.lastUpdated} readTime={guide.data.readTime} />
         ))}
         </div>
       </div>
     </section>

     <section class="border-t border-hairline dark:border-overlay-light" aria-labelledby="recent-heading">
       <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
         <h2 id="recent-heading" class="text-3xl font-semibold text-ink mb-8 dark:text-on-primary">Recently Added</h2>
         <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
         {recentGuides.map(guide => (
           <GuideCard title={guide.data.title} description={guide.data.description} slug={guide.id} category={guide.data.category} lastUpdated={guide.data.lastUpdated} readTime={guide.data.readTime} />
         ))}
         </div>
       </div>
     </section>

     <section class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="glossary-cta-heading">
       <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
         <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
           <div class="card dark:border-overlay-lighter dark:bg-surface">
              <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Tax Glossary</h3>
              <p class="mt-2 text-body dark:text-muted">Quick definitions for essential tax terms. From AGI to withholding — understand the language of taxes and make informed decisions about your finances.</p>
              <p class="mt-3 text-sm text-muted dark:text-muted">Browse hundreds of terms organized by category, with examples and links to related guides and calculators.</p>
              <a href="/knowledge/glossary" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">Browse Glossary</a>
            </div>
            <div class="card dark:border-overlay-lighter dark:bg-surface">
              <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Tax Calculators</h3>
              <p class="mt-2 text-body dark:text-muted">Put your knowledge into practice with our free, instant tax calculators for 10+ countries. Get accurate estimates for income tax, capital gains, GST/VAT, and more.</p>
              <p class="mt-3 text-sm text-muted dark:text-muted">All calculators use up-to-date rates and rules so you can plan with confidence.</p>
              <a href="/countries" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">Try a Calculator</a>
            </div>
        </div>
      </div>
    </section>

    <section class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="learning-paths-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="learning-paths-heading" class="text-3xl font-semibold text-ink mb-8 dark:text-on-primary">Learning Paths</h2>
        <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-6">
          Tax knowledge is most valuable when it is applied in a structured way. Our learning paths are designed sequences of guides that take you from foundational concepts to advanced strategies. Whether you have thirty minutes or thirty days, you can follow a path that matches your schedule and goals.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            <div class="card dark:border-overlay-lighter dark:bg-surface">
             <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Beginner: Tax Basics</h3>
             <p class="mt-2 text-body dark:text-muted">Start here if you are new to taxation. Learn about taxable income, deductions, credits, and how tax brackets work. This path covers the vocabulary and logic you need before diving into country-specific rules.</p>
             <a href="/knowledge/what-is-income-tax" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">Start Learning</a>
           </div>
           <div class="card dark:border-overlay-lighter dark:bg-surface">
             <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Intermediate: Filing and Compliance</h3>
             <p class="mt-2 text-body dark:text-muted">For individuals who file their own taxes and want to improve accuracy. Covers record keeping, deadline management, common mistakes, and how to use our calculators to cross-check your return.</p>
             <a href="/knowledge/tax-brackets-explained" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">Start Learning</a>
           </div>
           <div class="card dark:border-overlay-lighter dark:bg-surface">
             <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Advanced: Planning and Optimization</h3>
             <p class="mt-2 text-body dark:text-muted">For experienced taxpayers and small business owners. Explore tax-loss harvesting, retirement account strategies, cross-border considerations, and long-term wealth preservation within legal boundaries.</p>
             <a href="/knowledge/tax-planning-basics" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">Start Learning</a>
           </div>
        </div>
      </div>
    </section>

    <section class="border-t border-hairline dark:border-overlay-light" aria-labelledby="certification-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="card dark:border-overlay-lighter dark:bg-surface">
          <h2 id="certification-heading" class="text-3xl font-semibold text-ink mb-6 dark:text-on-primary">Certification and Verification</h2>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-4">
            While Finsiva does not offer formal certification programs, we partner with educational institutions and professional bodies to provide supplementary learning materials. Our guides are aligned with curriculum standards used in accounting and finance programs, making them useful study aids for students pursuing CPA, CA, or ACCA qualifications.
          </p>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl mb-4">
            Each guide includes learning objectives, key takeaways, and practice questions where applicable. Readers can track their progress by bookmarking completed guides or maintaining a personal study log. We also provide citation-ready summaries for students and researchers who need to reference our content in academic work.
          </p>
          <p class="text-body leading-relaxed dark:text-muted max-w-3xl">
            If you are an educator or institution interested in integrating Finsiva guides into your curriculum, please contact us to discuss licensing, customization, and bulk access options. We are happy to support tax education initiatives that align with our mission of accessibility and accuracy.
          </p>
        </div>
      </div>
    </section>
  </article>
</Layout>