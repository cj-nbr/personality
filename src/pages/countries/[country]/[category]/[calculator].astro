---
import CountryLayout from "../../../../layouts/CountryLayout.astro";
import { getCountryBySlug, getCategoryBySlug } from "../../../../data/countries";
import { getCurrency, formatCurrency } from "../../../../config/currencies";
import { getTaxYears } from "../../../../config/taxYears";
import { calculatorContent } from "../../../../config/calculatorContent";
import type { TaxRule } from "../../../../config/taxRules";

export function getStaticPaths() {
  const paths: { params: { country: string; category: string; calculator: string } }[] = [];
  const allCountries = [
    "united-states", "india", "hong-kong", "singapore", "indonesia",
    "malaysia", "new-zealand", "pakistan", "philippines", "united-kingdom"
  ];
  
  allCountries.forEach(countrySlug => {
    const country = getCountryBySlug(countrySlug);
    if (!country) return;
    
    country.taxCategories.forEach(category => {
      category.calculators.forEach(calc => {
        paths.push({
          params: {
            country: countrySlug,
            category: category.slug,
            calculator: calc.slug
          }
        });
      });
    });
  });
  
  return paths;
}

const country = getCountryBySlug(Astro.params.country!);
const category = getCategoryBySlug(Astro.params.country!, Astro.params.category!);
const calculator = category?.calculators.find(c => c.slug === Astro.params.calculator);

if (!country || !category || !calculator) {
  return Astro.redirect("/countries");
}

const currency = getCurrency(country.currency);
const taxYearOptions = getTaxYears(country.slug);

const ruleId = `${country.slug}-${category.slug}-${calculator.slug}`;
const rule = (await import("../../../../config/taxRules")).taxRules.find(
  (r: TaxRule) => r.id === ruleId
) as TaxRule | undefined;

const content = calculatorContent[ruleId];

const relatedCalculators = country.taxCategories
  .flatMap(cat => cat.calculators.map(calc => ({ ...calc, categorySlug: cat.slug })))
  .filter(rc => rc.slug !== calculator.slug || rc.categorySlug !== category.slug)
  .slice(0, 6);

const suggestedArticles = country.taxCategories
  .filter(cat => cat.slug !== category.slug)
  .slice(0, 3)
  .map(cat => ({
    title: cat.name + ' Guide',
    slug: '/countries/' + country.slug + '/' + cat.slug
  }));

const today = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

function buildDefaultContent() {
  return {
    overview: {
      title: "Overview",
      html: `<p>This ${country.name} ${category.name.toLowerCase()} calculator helps you estimate your ${calculator.name.toLowerCase()} quickly and accurately. Enter your income and other details below to see an estimate of your tax liability, effective tax rate, and take-home pay. This tool is updated regularly to reflect the latest tax laws and regulations for ${country.name}.</p><p>Use this calculator for planning and estimation purposes. For official tax advice, consult a qualified tax professional familiar with ${country.name} tax law.</p>`
    },
    howToUse: {
      title: "How to Use",
      html: `<p>Use this ${country.name} ${category.name} calculator to estimate your tax liability:</p><ol class="list-decimal pl-6 space-y-2"><li>Enter your <strong>annual income</strong> or relevant amount in the field provided.</li><li>Select your <strong>filing status</strong>, <strong>tax year</strong>, or other required options.</li><li>Click <strong>Calculate</strong> to see your estimated tax results.</li></ol><p>You can click <strong>Reset</strong> to clear the form and start over. Review the results carefully and use them as an estimate only.</p>`
    },
    understandingResults: {
      title: "Understanding Results",
      html: `<p><strong>Taxable Income:</strong> Income subject to tax after deductions.<br><strong>Tax Amount:</strong> Total tax liability.<br><strong>Effective Rate:</strong> Tax as a percentage of your total income.<br><strong>Take-Home Pay:</strong> Income after tax.</p>`
    },
    formula: {
      title: "Formula",
      html: `<p>Tax is computed using applicable rates and rules for ${country.name}. Review the detailed methodology above for assumptions and calculations.</p>`
    },
    workedExample: {
      title: "Example Calculation",
      html: `<p>Let's say you have an annual income of ${country.currency === 'USD' ? '$50,000' : country.currency === 'GBP' ? '£40,000' : country.currency === 'INR' ? '₹500,000' : country.currency === 'HKD' ? 'HK$300,000' : country.currency === 'SGD' ? 'S$50,000' : country.currency === 'MYR' ? 'RM60,000' : country.currency === 'NZD' ? 'NZ$50,000' : country.currency === 'PKR' ? 'PKR 1,200,000' : country.currency === 'PHP' ? 'PHP 400,000' : country.currency === 'IDR' ? 'Rp 75,000,000' : '50,000'}.</p><p>After applying the ${country.name} ${category.name.toLowerCase()} rules and deductions, your estimated tax liability and take-home pay will be calculated automatically by the tool above. Try entering your own values to see personalized results.</p>`
    },
    benefits: {
      title: "Benefits of Using This Calculator",
      html: `<ul class="list-disc pl-6 space-y-2"><li>Fast, instant tax estimates without manual calculations.</li><li>Up-to-date tax rates and slabs for ${country.name}.</li><li>Compare different scenarios by adjusting your inputs.</li><li>Understand your effective tax rate and take-home pay.</li><li>Plan your finances better with accurate estimates.</li></ul>`
    },
    limitations: {
      title: "Limitations",
      html: `<ul class="list-disc pl-6 space-y-2"><li>This is an estimate; actual tax may vary based on your full financial situation.</li><li>Does not account for every possible deduction, credit, or exemption.</li><li>Tax laws change frequently; verify current rates with official sources.</li><li>For complex situations (multiple income sources, business income, foreign income), consult a tax professional.</li></ul>`
    },
    taxSlabs: {
      title: "Tax Slabs",
      html: `<p>${country.name} ${category.name} slabs vary based on income level and taxpayer profile. Use this calculator to determine your exact liability under current rules.</p>`
    },
    commonMistakes: {
      title: "Common Mistakes",
      html: `<ul class="list-disc pl-6 space-y-2"><li>Not updating inputs for the correct tax year.</li><li>Using incorrect residency or employment status.</li><li>Forgetting to account for all income sources.</li><li>Not considering eligible deductions and reliefs.</li></ul>`
    },
    faq: [
      { question: "What is the standard tax rate?", answer: "Tax rates vary by income level and jurisdiction. The calculator applies the most common rates for your selected profile." },
      { question: "How accurate is this calculator?", answer: "This calculator provides estimates based on publicly available tax rules. For precise calculations, consult a tax professional or your local tax authority." },
      { question: "Do I need to file a tax return?", answer: "Tax filing requirements vary by country and income level. Check with your local tax authority to determine if you need to file a return." }
    ],
    relatedCalculators: {
      title: "Related Calculators",
      html: `<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">\n    <a href="/countries/${country.slug}" class="block rounded border p-4 hover:border-primary transition">More ${country.name} Calculators</a>\n    <a href="/countries" class="block rounded border p-4 hover:border-primary transition">All Countries</a>\n    <a href="/" class="block rounded border p-4 hover:border-primary transition">Home</a>\n  </div>`
    },
    suggestedArticles: {
      title: "Suggested Articles",
      html: `<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">\n    <a href="/countries/${country.slug}/${category.slug}" class="block rounded border p-4 hover:border-primary transition">${category.name} Guide</a>\n    <a href="/countries/${country.slug}" class="block rounded border p-4 hover:border-primary transition">${country.name} Tax Overview</a>\n    <a href="/" class="block rounded border p-4 hover:border-primary transition">All Calculators</a>\n  </div>`
    },
    officialResources: {
      title: "Official Government Resources",
      html: `<ul class="space-y-2"><li><a href="${country.taxAuthorityUrl}" target="_blank" rel="noopener noreferrer">${country.officialTaxAuthority}</a></li></ul><p>Always verify tax calculations with the latest information from official government sources.</p>`
    },
    educationalDisclaimer: {
      title: "Educational Disclaimer",
      text: `This calculator is provided for informational and educational purposes only. It does not constitute legal, financial, or tax advice. Tax laws are complex and subject to change. Always consult a qualified tax professional or your local tax authority for advice specific to your circumstances.`
    },
    relatedCountry: {
      title: "Related Country",
      html: `<a href="/countries/${country.slug}" class="block rounded-lg border border-hairline bg-canvas p-6 hover:border-primary transition dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary"><h3 class="text-lg font-semibold text-ink dark:text-on-primary">${country.name} Tax Overview</h3><p class="text-sm text-muted mt-1 dark:text-muted">Browse all ${country.name} tax calculators and guides.</p></a>`
    },
    faqSchema: {
      "What is the standard tax rate?": "Tax rates vary by country and type of income. Check the latest official guidelines.",
      "How do I calculate tax?": "Enter your details in the calculator and click Calculate for an estimate."
    }
  };
}

const defaultContent = buildDefaultContent();
const mergedContent = {
  howToUse: content?.howToUse || defaultContent.howToUse,
  understandingResults: content?.understandingResults || defaultContent.understandingResults,
  formula: content?.formula || defaultContent.formula,
  workedExample: content?.workedExample || defaultContent.workedExample,
  taxSlabs: content?.taxSlabs || defaultContent.taxSlabs,
  commonMistakes: content?.commonMistakes || defaultContent.commonMistakes,
  benefits: content?.benefits || defaultContent.benefits,
  limitations: content?.limitations || defaultContent.limitations,
  relatedCalculators: content?.relatedCalculators || defaultContent.relatedCalculators,
  suggestedArticles: content?.suggestedArticles || defaultContent.suggestedArticles,
  officialResources: content?.officialResources || defaultContent.officialResources,
  educationalDisclaimer: content?.educationalDisclaimer || defaultContent.educationalDisclaimer,
  relatedCountry: content?.relatedCountry || defaultContent.relatedCountry,
  faq: content?.faq || defaultContent.faq,
  faqSchema: content?.faqSchema || defaultContent.faqSchema,
  overview: content?.overview || defaultContent.overview,
};

---

<CountryLayout
  title={`${calculator.name}`}
  description={calculator.description}
  breadcrumbs={[
    { label: "Countries", href: "/countries" },
    { label: country.name, href: `/countries/${country.slug}` },
    { label: category.name, href: `/countries/${country.slug}/${category.slug}` },
    { label: calculator.name }
  ]}
>
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-4xl font-bold text-ink dark:text-on-primary" data-i18n={calculator.name}>{calculator.name}</h1>
      <p class="mt-2 text-lg text-body dark:text-muted" data-i18n={calculator.description}>{calculator.description}</p>
    </div>
  </div>

  <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-muted">
    <span class="tag tag-primary">{country.name}</span>
    <span class="tag">{category.name}</span>
    <span class="tag">Last updated: {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
  </div>

  <div class="rounded-lg border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface">
    <div id="calc-overview" class="mb-8">
      <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary" set:html={mergedContent.overview.title}></h2>
      <div class="prose max-w-none text-body dark:text-muted space-y-4" set:html={mergedContent.overview.html}></div>
    </div>

    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" data-i18n="calculator.input_heading">Calculator Input</h2>
      
      {rule ? (
        <form id="calc-form" class="space-y-6" onsubmit="event.preventDefault()" data-rule-id={rule.id} data-country-currency={country.currency}>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {rule.inputs.map((input) => (
              <div>
                <label for={input.id} class="block text-sm font-medium text-ink mb-2 dark:text-on-primary">
                  <span data-i18n={input.label}>{input.label}</span>
                  {input.required && <span class="text-danger ml-1">*</span>}
                </label>
                
                {input.type === "select" ? (
                  <select
                    id={input.id}
                    class="form-select"
                  >
                    {input.options?.map((opt) => (
                      <option value={opt.value} selected={opt.value === input.defaultValue} data-i18n={opt.label}>{opt.label}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    type={input.type}
                    id={input.id}
                    autocomplete="off"
                    placeholder={input.placeholder}
                    data-i18n-placeholder={input.placeholder}
                    class="form-input"
                  />
                )}
                
                {input.helpText && (
                  <p class="mt-1 text-sm text-muted dark:text-muted" data-i18n={input.helpText}>{input.helpText}</p>
                )}
              </div>
            ))}
          </div>

          <div class="flex gap-4">
            <button
              type="button"
              id="calc-btn"
              class="btn btn-primary"
              data-i18n="calculator.calculate"
            >
              Calculate
            </button>
            <button
              type="button"
              id="reset-btn"
              class="btn btn-secondary"
              data-i18n="calculator.reset"
            >
              Reset
            </button>
          </div>
        </form>
      ) : (
        <form id="calc-form" class="space-y-6" onsubmit="event.preventDefault()">
          <p class="text-body dark:text-muted" data-i18n="calculator.no_inputs">No calculator inputs are configured for this page. Please select a different calculator.</p>
        </form>
      )}

      <div id="result-wrapper" class="mt-8" aria-live="polite" aria-atomic="true">
        <div id="calc-announcement" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
        <div id="result-empty" class="empty-state rounded-xl border-2 border-dashed border-hairline bg-canvas-soft dark:border-overlay-lighter dark:bg-surface">
          <div class="empty-state-icon mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 dark:bg-on-primary/10">
            <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m-6 4h6m-6 4h4M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <p class="empty-state-title text-lg font-medium text-ink dark:text-on-primary">Your calculation results will appear here.</p>
          <p class="empty-state-description mt-1 text-sm text-muted dark:text-muted">Enter your details above and click Calculate to see your estimated tax.</p>
        </div>

        <div id="result" class="hidden" role="region" aria-label="Calculation results">
          <div class="no-print mb-4 flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-xl font-semibold text-ink dark:text-on-primary" data-i18n="results.title">Results</h3>
            <div class="flex flex-wrap items-center gap-2">
              <button id="print-btn" class="btn btn-secondary btn-sm" aria-label="Print calculator results" onclick="window.print()">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                Print
              </button>
              <button id="copy-result-btn" class="btn btn-secondary btn-sm" aria-label="Copy result to clipboard">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                Copy
              </button>
              <button id="share-btn" class="btn btn-secondary btn-sm" aria-label="Share this calculator">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                <span data-i18n="actions.share">Share</span>
              </button>
            </div>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
             {rule ? (
               <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                 {rule.outputs.map((output) => {
                   const isHighlighted = ['incomeTax', 'totalTax', 'federalTax', 'capitalGainsTax', 'takeHomePay', 'afterTaxIncome', 'afterTaxGain', 'cess', 'totalDeductions', 'stampDuty', 'propertyTax', 'salariesTax', 'profitsTax', 'totalFICA', 'socialSecurity', 'medicare'].includes(output.id);
                   return (
                     <div class={"rounded-lg border p-4 " + (isHighlighted ? "border-primary/30 bg-primary/5 dark:border-primary/20 dark:bg-primary/5" : "border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface")}>
                       <p class={"text-sm font-medium text-muted dark:text-muted"} data-i18n={output.label}>{output.label}</p>
                       <p class={"mt-2 font-bold " + (isHighlighted ? "text-2xl text-primary dark:text-on-primary" : "text-xl text-ink dark:text-on-primary")} id={"result-" + output.id}>
                         {output.format === "currency" ? formatCurrency(0, country.currency) : output.format === "percentage" ? "0%" : "0"}
                       </p>
                       <p class="text-xs text-muted mt-1 dark:text-muted" data-i18n={output.description}>{output.description}</p>
                     </div>
                   );
                 })}
               </div>
             ) : (
               <p class="text-3xl font-bold text-primary dark:text-on-primary" id="result-value">
                 {formatCurrency(0, country.currency)}
               </p>
             )}

             <div id="premium-dashboard-wrapper" class="hidden">
               <div id="premium-dashboard-container"></div>
             </div>

             <p class="text-sm text-muted mt-4 dark:text-muted" data-i18n="calculator.estimate_disclaimer">
               This is an estimate. Consult a tax professional for accurate calculations.
             </p>
           </div>
          <div class="no-print mt-4">
            <button id="copy-result-text-btn" class="btn btn-ghost btn-sm text-muted hover:text-ink dark:text-muted dark:hover:text-on-primary" aria-label="Copy result text">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              Copy
            </button>
          </div>
        </div>
      </div>

      <div id="calc-error" class="mt-4 hidden" role="alert">
         <p class="text-sm text-danger mt-4" data-i18n="calculator.error">Please enter valid values for all required fields</p>
      </div>
    </div>
  </div>

  {rule && rule.examples && rule.examples.length > 0 && (
    <div class="mt-12">
      <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" set:html={mergedContent.workedExample?.title || "Example Calculation"}></h2>
      <div class="rounded-lg border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div>
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-on-primary" set:html={rule.examples[0].title}></h3>
            <div class="space-y-2">
              {Object.entries(rule.examples[0].inputs).map(([key, value]) => {
                const inputDef = rule.inputs.find(i => i.id === key);
                return (
                  <div class="flex justify-between">
                    <span class="text-body dark:text-muted" data-i18n={inputDef?.label || key}>{inputDef?.label || key}:</span>
                    <span class="font-medium text-ink dark:text-on-primary">{value}</span>
                  </div>
                );
              })}
            </div>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-on-primary" data-i18n="result.title">Result</h3>
            <div class="space-y-2">
              {Object.entries(rule.examples[0].outputs).map(([key, value]) => {
                const outputDef = rule.outputs.find(o => o.id === key);
                const formattedValue = outputDef?.format === "currency" 
                  ? formatCurrency(value, country.currency)
                  : outputDef?.format === "percentage"
                  ? `${value}%`
                  : String(value);
                return (
                  <div class="flex justify-between">
                    <span class="text-body dark:text-muted" data-i18n={outputDef?.label || key}>{outputDef?.label || key}:</span>
                    <span class="font-medium text-ink dark:text-on-primary">{formattedValue}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <p class="mt-4 text-sm text-muted dark:text-muted" set:html={rule.examples[0].explanation}></p>
      </div>
    </div>
  )}

  {rule && rule.formulas && rule.formulas.length > 0 && (
    <div class="mt-12">
      <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" data-i18n="methodology.title">Calculation Methodology</h2>
      <div class="rounded-lg border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
        <div class="space-y-6">
          {rule.formulas.map((formula) => (
            <div>
              <h3 class="text-lg font-semibold text-ink dark:text-on-primary" data-i18n={formula.name}>{formula.name}</h3>
              <code class="block mt-2 rounded-lg bg-canvas-soft p-3 text-sm font-mono text-primary dark:bg-surface dark:text-on-primary">
                {formula.formula}
              </code>
              <p class="mt-2 text-sm text-body dark:text-muted" data-i18n={formula.description}>{formula.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <script is:inline>
    (function() {
      var form = document.getElementById('calc-form');
      var calcBtn = document.getElementById('calc-btn');
      var resetBtn = document.getElementById('reset-btn');
      var resultDiv = document.getElementById('result');
      var resultEmpty = document.getElementById('result-empty');
      var resultWrapper = document.getElementById('result-wrapper');
      var errorDiv = document.getElementById('calc-error');
      var copyResultBtn = document.getElementById('copy-result-btn');
      var shareBtn = document.getElementById('share-btn');
      var ruleId = form ? form.getAttribute('data-rule-id') : '';
      var currencyCode = form ? form.getAttribute('data-country-currency') || 'USD' : 'USD';

      var currencySymbols = {
        USD: '$', INR: '₹', HKD: 'HK$', SGD: 'S$', IDR: 'Rp',
        MYR: 'RM', NZD: 'NZ$', PKR: 'Rs', PHP: '₱', GBP: '£'
      };

      function getInput(id) {
        var el = document.getElementById(id);
        if (!el) return null;
        if (el.type === 'number') return parseFloat(el.value) || 0;
        return el.value;
      }

      function fmt(num, dec) {
        if (dec === undefined) dec = 2;
        return num.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
      }

      function fmtCurrency(num, code) {
        var sym = currencySymbols[code] || '$';
        var dec = (code === 'IDR' || code === 'PKR' || code === 'INR') ? 0 : 2;
        return sym + fmt(num, dec);
      }

      function setOutput(id, value, format) {
        var el = document.getElementById('result-' + id);
        if (!el) return;
        if (format === 'currency') el.textContent = fmtCurrency(value, currencyCode);
        else if (format === 'percentage') el.textContent = value.toFixed(1) + '%';
        else el.textContent = fmt(value, 0);
      }

      function pTax(income, brackets) {
        var tax = 0, prev = 0;
        for (var i = 0; i < brackets.length; i++) {
          var lim = brackets[i][0], r = brackets[i][1];
          if (income > prev) {
            var taxable = Math.min(income, lim) - prev;
            tax += taxable * r;
          }
          prev = lim;
        }
        return tax;
      }

      function showError() {
        if (errorDiv) errorDiv.classList.remove('hidden');
        if (resultDiv) resultDiv.classList.add('hidden');
        if (resultEmpty) resultEmpty.classList.remove('hidden');
      }

      function hideError() {
        if (errorDiv) errorDiv.classList.add('hidden');
      }

