      function calcPKSindhVehicleTax() {
        var cc = getInput('engineCapacity') || 0;
        var age = getInput('vehicleAge') || 0;
        var tax = 0;
        if(cc<800) tax=50; else if(cc<=1300) tax=100; else if(cc<=1500) tax=150; else if(cc<=1800) tax=200; else if(cc<=2000) tax=300; else if(cc<=2500) tax=400; else tax=500;
        var transfer = 5000 + age*500;
        setOutput('vehicleTax', tax, 'currency');
        setOutput('transferFee', transfer, 'currency');
      }

      function calcPKIslamabadVehicleTax() {
        var cc = getInput('engineCapacity') || 0;
        var vtype = getInput('vehicleType') || 'car';
        var tax = 0;
        if(cc<800) tax=50; else if(cc<=1300) tax=100; else if(cc<=1500) tax=150; else if(cc<=1800) tax=200; else if(cc<=2000) tax=300; else if(cc<=2500) tax=400; else tax=500;
        setOutput('vehicleTax', tax, 'currency');
      }

      function calculate() {
        if (!form) return;

        var inputs = form.querySelectorAll('input[required], select[required]');
        var valid = true;
        inputs.forEach(function(input) {
          if ((input.type === 'number' && (!input.value || parseFloat(input.value) <= 0)) ||
              (input.tagName === 'SELECT' && !input.value)) {
            valid = false;
            markInvalid(input);
          } else {
            clearInvalid(input);
          }
        });

        if (!valid) { showError(); return; }
        hideError();

        try {
          if (ruleId === 'united-states-income-tax-federal-income-tax') calcUSFederalIncomeTax();
          else if (ruleId === 'united-states-income-tax-state-income-tax') calcStateTax();
          else if (ruleId === 'united-states-payroll-tax-payroll-tax-calculator') calcFICA();
          else if (ruleId === 'united-states-corporate-tax-corporate-tax-calculator') calcCorporate();
          else if (ruleId === 'united-states-capital-gains-tax-capital-gains-calculator') calcCapitalGains();
          else if (ruleId === 'india-income-tax-income-tax-calculator') calcIndiaIncomeTax();
          else if (ruleId === 'india-gst-gst-calculator') calcGenericVATorGST(getInput('gstRate') || '18', getInput('calculationType') || 'exclusive');
          else if (ruleId === 'india-tds-tds-calculator') calcTDS();
          else if (ruleId === 'malaysia-income-tax-income-tax-calculator') calcGenericIncomeTax([[5000,0],[20000,0.01],[35000,0.03],[50000,0.06],[70000,0.11],[100000,0.19],[1000001,0.25],[250000,0.26],[10000000,0.30]]);
          else if (ruleId === 'malaysia-sst-sst-calculator') calcSST();
          else if (ruleId === 'new-zealand-income-tax-income-tax-calculator') calcGenericIncomeTax([[14000,0.105],[48000,0.175],[70000,0.30],[180000,0.33],[10000000,0.39]]);
          else if (ruleId === 'new-zealand-gst-gst-calculator') calcGenericVATorGST(0.15, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'pakistan-income-tax-income-tax-calculator') calcGenericIncomeTax([[600000,0],[1200000,0.05],[2400000,0.10],[3600000,0.15],[6000000,0.20],[9600000,0.25],[10000000,0.30],[10000001,0.35]]);
          else if (ruleId === 'pakistan-sales-tax-sales-tax-calculator') calcGenericVATorGST(0.18, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'philippines-income-tax-income-tax-calculator') calcGenericIncomeTax([[250000,0],[400000,0.20],[800000,0.25],[2000000,0.30],[8000000,0.35],[10000000,0.35]]);
          else if (ruleId === 'philippines-vat-vat-calculator') calcGenericVATorGST(0.12, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-kingdom-income-tax-income-tax-calculator') calcUKIncomeTax();
          else if (ruleId === 'united-kingdom-vat-vat-calculator') calcGenericVATorGST(getInput('vatRate') || '20', getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-kingdom-national-insurance-ni-calculator') calcNIContributions();
          else if (ruleId === 'hong-kong-salaries-tax-salaries-tax-calculator') calcHKSalariesTax();
          else if (ruleId === 'singapore-income-tax-income-tax-calculator') calcGenericIncomeTax([[20000,0],[30000,0.02],[40000,0.035],[80000,0.07],[120000,0.115],[160000,0.15],[200000,0.18],[240000,0.19],[280000,0.205],[320000,0.22],[10000000,0.24]]);
          else if (ruleId === 'singapore-gst-gst-calculator') calcGenericVATorGST(0.09, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'singapore-stamp-duty-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'indonesia-income-tax-income-tax-calculator') calcGenericIncomeTax([[60000000,0],[250000000,0.05],[500000000,0.15],[2000000000,0.25],[2500000000,0.30],[10000000,0.35]]);
          else if (ruleId === 'indonesia-vat-vat-calculator') calcGenericVATorGST(0.11, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-states-income-tax-effective-tax-rate') calcEffectiveRate();
          else if (ruleId === 'united-states-estate-tax-estate-tax-calculator') calcEstateTax();
          else if (ruleId === 'united-states-payroll-tax-payroll-tax-calculator') calcFICA();
          else if (ruleId === 'united-states-payroll-tax-fica-calculator') calcFICA();
          else if (ruleId === 'united-states-payroll-tax-self-employment-tax') calcFICA();
          else if (ruleId === 'united-states-corporate-tax-small-business-tax') calcCorporate();
          else if (ruleId === 'united-states-capital-gains-tax-ltcg-calculator') calcCapitalGains();
          else if (ruleId === 'hong-kong-salaries-tax-salary-tax-computation') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hk-net-salary-calculator') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hong-kong-tax-calculator-for-expats') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hong-kong-income-tax-for-foreigners-calculator') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-profits-tax-hk-corporate-tax-calculator') calcHKProfitsTax();
          else if (ruleId === 'hong-kong-profits-tax-profit-tax-computation') calcHKProfitsTax();
          else if (ruleId === 'hong-kong-stamp-duty-hk-property-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-rental-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-first-registration-tax-calculator') calcHKFirstRegTax();
          else if (ruleId === 'hong-kong-property-tax-property-tax-calculator') calcHKPropertyTax();
          else if (ruleId === 'hong-kong-property-tax-hk-rental-tax-deduction-calculator') calcHKPropertyTax();
          else if (ruleId === 'pakistan-income-tax-salary-tax-calculator') calcGenericIncomeTax([[600000,0],[1200000,0.05],[2400000,0.10],[3600000,0.15],[6000000,0.20],[9600000,0.25],[10000000,0.30],[10000001,0.35]]);
          else if (ruleId === 'pakistan-income-tax-business-income-tax-calculator') calcGenericIncomeTax([[600000,0],[1200000,0.05],[2400000,0.10],[3600000,0.15],[6000000,0.20],[9600000,0.25],[10000000,0.30],[10000001,0.35]]);
          else if (ruleId === 'pakistan-income-tax-capital-gain-tax-calculator') calcPKCapitalGain();
          else if (ruleId === 'pakistan-sales-tax-gst-calculator') calcGenericVATorGST(0.18, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'pakistan-property-tax-property-tax-calculator') calcPKPropertyTax();
          else if (ruleId === 'pakistan-property-tax-capital-gain-tax-calculator') calcPKCapitalGain();
          else if (ruleId === 'pakistan-property-tax-token-tax-calculator') calcPKTokenTax();
          else if (ruleId === 'pakistan-property-tax-rental-income-tax-calculator') calcGenericIncomeTax([[600000,0],[1200000,0.05],[2400000,0.10],[3600000,0.15],[6000000,0.20],[9600000,0.25],[10000000,0.30],[10000001,0.35]]);
          else if (ruleId === 'pakistan-vehicle-tax-vehicle-tax-calculator') calcPKVehicleTax();
          else if (ruleId === 'pakistan-vehicle-tax-sindh-vehicle-tax-calculator') calcPKSindhVehicleTax();
          else if (ruleId === 'pakistan-vehicle-tax-islamabad-vehicle-tax-calculator') calcPKIslamabadVehicleTax();
          else if (ruleId === 'singapore-stamp-duty-stamp-duty-calculator') calcStampDuty();
          else { hideError(); return; }

          showResults();
          if (resultWrapper) {
            var isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            resultWrapper.scrollIntoView({ behavior: isReducedMotion ? 'auto' : 'smooth', block: 'start' });
          }
          var liveRegion = document.getElementById('calc-announcement');
          if (liveRegion) liveRegion.textContent = 'Calculation complete. Results updated.';
        } catch(e) { showError(); }
      }

      function reset() {
        form.reset();
        if (resultDiv) resultDiv.classList.add('hidden');
        if (resultEmpty) resultEmpty.classList.remove('hidden');
        if (errorDiv) errorDiv.classList.add('hidden');
        var premiumWrapper = document.getElementById('premium-dashboard-wrapper');
        if (premiumWrapper) premiumWrapper.classList.add('hidden');
        var copyBtn = document.getElementById('copy-result-text-btn');
        if (copyBtn) copyBtn.style.display = 'none';
      }

      function copyResult() {
        if (!resultDiv) return;
        var text = resultDiv.innerText;
        if (!text) return;
        navigator.clipboard.writeText(text).then(function() {
          var copyTextBtn = document.getElementById('copy-result-text-btn');
          if (copyTextBtn) {
            copyTextBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
            setTimeout(function(){ copyTextBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy'; }, 2000);
          }
        }).catch(function() {});
      }

      function shareResult() {
        if (!resultDiv || resultDiv.classList.contains('hidden')) return;
        var text = resultDiv.innerText || '';
        var title = document.title || 'Finsiva Tax Calculator Result';
        var url = window.location.href;
        if (navigator.share) {
          navigator.share({ title: title, text: text, url: url }).catch(function(){});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url + '\n\n' + text).then(function() {
            var btn = document.getElementById('share-btn');
            if (btn) {
              btn.textContent = 'Link copied!';
              setTimeout(function(){ btn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg> Share'; }, 2000);
            }
          }).catch(function(){});
        }
      }

      if (calcBtn) calcBtn.addEventListener('click', calculate);
      if (resetBtn) resetBtn.addEventListener('click', reset);
      var copyTextBtn = document.getElementById('copy-result-text-btn');
      if (copyTextBtn) copyTextBtn.addEventListener('click', copyResult);
      if (copyResultBtn) copyResultBtn.addEventListener('click', copyResult);
      if (shareBtn) shareBtn.addEventListener('click', shareResult);
    })();
  </script>

