---
import CountryLayout from "../../../../../layouts/CountryLayout.astro";
import { getCountryBySlug, getCategoryBySlug } from "../../../../../data/countries";

export function getStaticPaths() {
  const paths: { params: { country: string; category: string; faq: string } }[] = [];
  const allCountries = [
    "united-states", "india", "hong-kong", "singapore", "indonesia",
    "malaysia", "new-zealand", "pakistan", "philippines", "united-kingdom"
  ];
  
  allCountries.forEach(countrySlug => {
    const country = getCountryBySlug(countrySlug);
    if (!country) return;
    
    country.taxCategories.forEach(category => {
      category.faqs.forEach((faq, index) => {
        paths.push({
          params: {
            country: countrySlug,
            category: category.slug,
            faq: `faq-${index}`
          }
        });
      });
    });
  });
  
  return paths;
}

const country = getCountryBySlug(Astro.params.country!);
const category = getCategoryBySlug(Astro.params.country!, Astro.params.category!);
const faqIndex = parseInt(Astro.params.faq!.replace('faq-', ''));
const faq = category?.faqs[faqIndex];

if (!country || !category || !faq) {
  return Astro.redirect("/countries");
}
---

<CountryLayout
  title={`${faq.question} | ${country.name}`}
  description={faq.answer}
  breadcrumbs={[
    { label: "Countries", href: "/countries" },
    { label: country.name, href: `/countries/${country.slug}` },
    { label: category.name, href: `/countries/${country.slug}/${category.slug}` },
    { label: "FAQ" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": {
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }
  })} />
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-ink dark:text-on-primary">{faq.question}</h1>
  </div>

  <div class="rounded-lg border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface">
    <p class="text-body leading-relaxed text-lg dark:text-muted">{faq.answer}</p>

    <div class="mt-8 pt-6 border-t border-hairline">
      <h2 class="text-xl font-semibold text-ink mb-4 dark:text-on-primary" data-i18n="faq.related_questions">Related Questions</h2>
      <ul class="space-y-2">
        {category.faqs.filter((_, i) => i !== faqIndex).slice(0, 5).map((relatedFaq, i) => (
          <li>
            <a
              href={`/countries/${country.slug}/${category.slug}/faqs/faq-${category.faqs.indexOf(relatedFaq)}`}
              class="text-link hover:underline dark:text-link"
            >
              {relatedFaq.question}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <section class="mt-8 rounded-xl border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface" aria-labelledby="faq-in-depth">
      <h2 id="faq-in-depth" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">In-Depth Explanation</h2>
      <p class="text-body leading-relaxed dark:text-muted">This question touches on a common point of confusion for taxpayers in {country.name}. Tax rules are often interpreted differently depending on individual circumstances, residency status, and the specific tax year in question. The answer provided above reflects the most common application of {category.name.toLowerCase()} rules, but your situation may involve additional factors.</p>
      <p class="mt-4 text-body leading-relaxed dark:text-muted">We recommend reviewing the official guidance from {country.officialTaxAuthority} and consulting a qualified tax professional for advice tailored to your specific circumstances. Our calculators and guides are designed for estimation and educational purposes, not as a substitute for professional tax advice.</p>
      <p class="mt-4 text-body leading-relaxed dark:text-muted">If you need help with a specific calculation, try our interactive {category.name} calculators on the <a href={`/countries/${country.slug}/${category.slug}`} class="text-link hover:underline dark:text-link">{category.name} page</a> for {country.name}.</p>
    </section>

    <section class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-light dark:bg-surface" aria-labelledby="faq-related">
      <h2 id="faq-related" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Related FAQs</h2>
      <ul class="space-y-3">
        {category.faqs.filter((_, i) => i !== faqIndex).slice(0, 6).map((relatedFaq, i) => (
          <li class="flex items-start gap-3 text-body dark:text-muted">
            <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <a href={`/countries/${country.slug}/${category.slug}/faqs/faq-${category.faqs.indexOf(relatedFaq)}`} class="text-link hover:underline dark:text-link">{relatedFaq.question}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-light dark:bg-surface" aria-labelledby="faq-help">
      <h2 id="faq-help" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Need More Help?</h2>
      <p class="text-body leading-relaxed dark:text-muted">If you could not find the answer you were looking for, we have additional resources available. Browse our <a href={`/countries/${country.slug}/${category.slug}`} class="text-link hover:underline dark:text-link">{category.name} guides</a> for detailed walkthroughs, or use our <a href={`/countries/${country.slug}`} class="text-link hover:underline dark:text-link">{country.name} tax calculators</a> for instant estimates. You can also reach out through our <a href="/contact" class="text-link hover:underline dark:text-link">contact page</a> for further assistance.</p>
    </section>

    <div class="mt-8 rounded-xl border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface">
      <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Share this FAQ</h2>
      <p class="text-body dark:text-muted">Help others find this answer by sharing it on social media or with friends and colleagues who might benefit from understanding {category.name.toLowerCase()} in {country.name}.</p>
    </div>

    <section class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-light dark:bg-surface" aria-labelledby="faq-context">
      <h2 id="faq-context" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Understanding the Context</h2>
      <p class="text-body leading-relaxed dark:text-muted">Tax questions rarely have one-size-fits-all answers. The response above covers the general rule for {category.name.toLowerCase()} in {country.name}, but individual circumstances can change the outcome significantly. Factors such as residency status, source of income, applicable double-taxation agreements, and specific deductions all influence the final position.</p>
      <p class="mt-4 text-body leading-relaxed dark:text-muted">We encourage you to use this FAQ as a starting point rather than definitive advice. Our interactive calculators can model different scenarios based on your inputs, and our detailed guides walk through the underlying concepts step by step. For complex matters, always verify with {country.officialTaxAuthority} or a qualified tax advisor.</p>
    </section>

    <section class="mt-8 rounded-xl border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface" aria-labelledby="faq-stay-updated">
      <h2 id="faq-stay-updated" class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Stay Updated</h2>
      <p class="text-body leading-relaxed dark:text-muted">Tax regulations in {country.name} evolve with each budget cycle and legislative session. To ensure you remain compliant and aware of new opportunities, consider the following practices: subscribe to updates from {country.officialTaxAuthority}, review our blog for country-specific analysis, and check this FAQ section regularly for newly answered questions.</p>
      <ul class="mt-4 list-disc pl-6 space-y-2 text-body dark:text-muted">
        <li>Bookmark the official {country.officialTaxAuthority} announcements page.</li>
        <li>Use our <a href={`/countries/${country.slug}`} class="text-link hover:underline dark:text-link">{country.name} calculator suite</a> to model changes as rates update.</li>
        <li>Read our latest <a href="/blogs" class="text-link hover:underline dark:text-link">tax blog posts</a> for strategic planning ideas.</li>
        <li>Consult the <a href="/knowledge" class="text-link hover:underline dark:text-link">Knowledge Center</a> for foundational concepts that underpin current rules.</li>
      </ul>
    </section>
  </div>
</CountryLayout>
