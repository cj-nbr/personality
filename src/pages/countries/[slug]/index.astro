---
import CountryLayout from "../../../layouts/CountryLayout.astro";
import { countries, getCountryBySlug } from "../../../data/countries";
import { getBaseUrl } from "../../../utils/routing";
import CountryHero from "../../../components/country/CountryHero.astro";
import CountryOverview from "../../../components/country/CountryOverview.astro";
import ImportantTaxInfo from "../../../components/country/ImportantTaxInfo.astro";
import TaxBrackets from "../../../components/country/TaxBrackets.astro";
import CommonDeductions from "../../../components/country/CommonDeductions.astro";
import TaxCredits from "../../../components/country/TaxCredits.astro";
import WhoShouldUse from "../../../components/country/WhoShouldUse.astro";
import HowToUse from "../../../components/country/HowToUse.astro";
import TaxFAQ from "../../../components/country/TaxFAQ.astro";
import RelatedContent from "../../../components/country/RelatedContent.astro";
import TrustSection from "../../../components/country/TrustSection.astro";

export function getStaticPaths() {
  return countries.map(country => ({
    params: { slug: country.slug }
  }));
}

const country = getCountryBySlug(Astro.params.slug!);

if (!country) {
  return Astro.redirect("/countries");
}

const baseUrl = getBaseUrl();

const allCalculators = [
  ...(country.salaryCalculators || []),
  ...(country.capitalGainsCalculators || []),
  ...(country.corporateCalculators || [])
];

const popularCalcs = country.popularCalculators || [];

const schema = {
  "@context": "https://schema.org",
  "@type": "TaxCountry",
  name: country.name,
  description: country.overview,
  url: `${baseUrl}/countries/${country.slug}`,
  taxSystem: {
    "@type": "TaxSystem",
    name: `${country.name} Tax System`,
    taxAuthority: {
      "@type": "GovernmentOrganization",
      name: country.officialTaxAuthority,
      url: country.taxAuthorityUrl
    },
    taxYear: country.taxYear,
    currency: country.currency
  },
  lastUpdated: country.lastUpdated
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  name: `${country.name} Tax FAQs`,
  url: `${baseUrl}/countries/${country.slug}`,
  mainEntity: (country.countryFAQs || []).map(faq => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Countries", item: `${baseUrl}/countries` },
    { "@type": "ListItem", position: 2, name: country.name, item: `${baseUrl}/countries/${country.slug}` }
  ]
};

const govOrgSchema = {
  "@context": "https://schema.org",
  "@type": "GovernmentOrganization",
  name: country.officialTaxAuthority,
  url: country.taxAuthorityUrl,
  description: `Official tax authority for ${country.name}`
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${country.name} Tax Guide`,
  description: country.overview,
  url: `${baseUrl}/countries/${country.slug}`,
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: baseUrl },
      { "@type": "ListItem", position: 2, name: "Countries", item: `${baseUrl}/countries` },
      { "@type": "ListItem", position: 3, name: country.name, item: `${baseUrl}/countries/${country.slug}` }
    ]
  },
  about: {
    "@type": "TaxCountry",
    name: country.name,
    taxAuthority: {
      "@type": "GovernmentOrganization",
      name: country.officialTaxAuthority
    }
  }
};
---

<CountryLayout
  title={`${country.name} Tax Guide | ${country.taxYear} Tax Brackets, Rates & Calculators`}
  description={`${country.name} tax guide: ${country.taxYear} tax brackets, rates, deductions, credits, filing deadlines, and official government resources. Calculate your tax with our free ${country.name} tax calculators.`}
  keywords={`${country.name} tax, ${country.name} tax calculator, ${country.name} tax brackets, ${country.name} income tax, ${country.name} tax rates, ${country.name} tax deductions, ${country.name} tax credits, ${country.name} filing deadline, ${country.name} tax authority, ${country.name} tax guide`}
  breadcrumbs={[
    { label: "Countries", href: "/countries" },
    { label: country.name, href: `/countries/${country.slug}` }
  ]}
  canonical={`${baseUrl}/countries/${country.slug}`}
  schema={schema}
  image={country.flag}
  imageAlt={`${country.name} tax guide - ${country.taxYear} tax brackets, rates, deductions, and credits`}
  robots="index,follow"
>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(govOrgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

<!-- SECTION 1: HERO -->
<CountryHero
  country={{
    name: country.name,
    flag: country.flag,
    continent: country.continent,
    taxSystemSummary: country.taxSystemSummary,
    taxYear: country.taxYear,
    currency: country.currency,
    capital: country.capital,
    lastUpdated: country.lastUpdated,
    officialTaxAuthority: country.officialTaxAuthority,
    taxAuthorityUrl: country.taxAuthorityUrl,
    slug: country.slug,
  }}
  popularCalculators={popularCalcs}
  salaryCalculators={country.salaryCalculators || []}
/>

<!-- SECTION 2: OVERVIEW -->
<CountryOverview country={country} />

<!-- SECTION 3: IMPORTANT TAX INFORMATION -->
<ImportantTaxInfo country={country} />

<!-- SECTION 4: TAX BRACKETS -->
<TaxBrackets country={country} />

<!-- SECTION 5: COMMON DEDUCTIONS -->
<CommonDeductions country={country} />

<!-- SECTION 6: TAX CREDITS -->
<TaxCredits country={country} />

<!-- SECTION 7: WHO SHOULD USE -->
<WhoShouldUse country={country} />

<!-- SECTION 8: HOW TO USE -->
<HowToUse country={country} />

<!-- SECTION 9: FAQS -->
<TaxFAQ country={country} />

<!-- SECTION 10: RELATED CONTENT -->
<RelatedContent
  country={{
    name: country.name,
    slug: country.slug,
    taxCategories: country.taxCategories,
    relatedCountries: country.relatedCountries,
    popularCalculators: popularCalcs,
    salaryCalculators: country.salaryCalculators || [],
    capitalGainsCalculators: country.capitalGainsCalculators || [],
    corporateCalculators: country.corporateCalculators || [],
  }}
  getCountryBySlug={getCountryBySlug}
/>

<!-- SECTION 11: TRUST & TRANSPARENCY -->
<TrustSection country={country} />

</CountryLayout>
