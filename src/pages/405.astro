---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout
  title="405 - Method Not Allowed | Finsiva"
  description="The requested method is not allowed for this resource."
  canonical="https://finsiva.com/"
  robots="noindex, nofollow"
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "405" }]} />
      <div class="text-center">
        <span class="text-6xl font-extrabold text-primary dark:text-link" aria-hidden="true">405</span>
        <h1 class="mt-4 text-3xl font-bold text-ink dark:text-on-primary">Method Not Allowed</h1>
        <p class="mt-4 text-lg text-body dark:text-muted">The requested method is not allowed for this resource. Please use a different method or visit our homepage.</p>
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row">
          <a href="/" class="btn btn-primary inline-flex items-center gap-2">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Go back home
          </a>
          <a href="/countries" class="btn btn-secondary inline-flex items-center gap-2">
            Browse Countries
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
