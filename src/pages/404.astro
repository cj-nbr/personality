---
import Layout from "../layouts/Layout.astro";
---

<Layout 
  title="404 - Page Not Found" 
  description="The page you are looking for could not be found."
  canonical="https://finsiva.com/"
>
  <meta name="robots" content="noindex, nofollow" />
  <div class="min-h-screen bg-canvas dark:bg-canvas flex items-center justify-center">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center">
      <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1200&q=80" alt="Friendly illustration of a lost page" class="mx-auto mb-6 w-full max-w-md rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />
      <h1 class="text-6xl font-bold text-ink mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary" data-i18n="pages.not_found">Page Not Found</h2>
      <p class="text-body text-lg mb-8 dark:text-muted" data-i18n="not_found.message">The page you are looking for could not be found. It may have been moved, deleted, or you entered the wrong URL.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a href="/countries" class="inline-block rounded-pill bg-primary px-6 py-3 text-base font-medium text-on-primary transition hover:opacity-90 dark:bg-on-primary dark:text-primary">Popular Calculators</a>
        <a href="/blogs" class="inline-block rounded-pill bg-primary px-6 py-3 text-base font-medium text-on-primary transition hover:opacity-90 dark:bg-on-primary dark:text-primary">Tax Blog</a>
        <a href="/contact" class="inline-block rounded-pill bg-primary px-6 py-3 text-base font-medium text-on-primary transition hover:opacity-90 dark:bg-on-primary dark:text-primary">Contact Us</a>
      </div>
      <a href="/" class="inline-block rounded-pill bg-primary px-6 py-3 text-base font-medium text-on-primary transition hover:opacity-90 dark:bg-on-primary dark:text-primary">
        <span data-i18n="pages.go_home">Go back home</span>
      </a>
    </div>
  </div>
</Layout>
