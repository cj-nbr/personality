const description = "Complete HRA calculation guide for salaried individuals. Learn how to calculate HRA exemption under Section 10(13A), HRA exemption formula, and maximize your tax savings with our HRA calculator.";
const image = "https://images.unsplash.com/photo-4Oxm-5DCxT0?w=1200&q=80";
