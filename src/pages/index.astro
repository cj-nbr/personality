---
import Layout from "../layouts/Layout.astro";
import { countries } from "../data/countries";
import { getBaseUrl } from "../utils/routing";

const baseUrl = getBaseUrl();
const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
    {
      "@type": "Question",
      "name": "How much tax will I pay?",
      "acceptedAnswer": { "@type": "Answer", "text": "Your tax depends on your total income, deductions, filing status, and jurisdiction. Our tax estimator uses current tax slabs and rules to provide an accurate estimate. Select your country, enter your income details, and review the instant breakdown." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my tax liability?",
      "acceptedAnswer": { "@type": "Answer", "text": "Start with your total income from all sources, subtract allowable deductions and exemptions to arrive at taxable income, then apply the relevant tax slab rates. Our income tax calculator automates this using the latest official rates and rules." }
    },
    {
      "@type": "Question",
      "name": "What is an income tax calculator?",
      "acceptedAnswer": { "@type": "Answer", "text": "An income tax calculator is an online tool that estimates tax owed based on income, deductions, and applicable tax laws. It helps you understand take-home pay, effective tax rate, and potential refund. Finsiva supports multiple countries and tax types." }
    },
    {
      "@type": "Question",
      "name": "Is a tax calculator free to use?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. All core tax calculators on Finsiva are completely free with no paywalls, subscriptions, or hidden charges. Calculations run locally in your browser with no registration required." }
    },
    {
      "@type": "Question",
      "name": "How accurate are online tax calculators?",
      "acceptedAnswer": { "@type": "Answer", "text": "Online tax calculators provide estimates based on official tax rules and slab rates. They are accurate for planning purposes but may differ from final liability due to jurisdiction-specific nuances. Always verify important tax decisions with local tax authorities or a qualified professional." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate income tax online?",
      "acceptedAnswer": { "@type": "Answer", "text": "Select your country, enter your annual income, choose your filing status and tax year, then input applicable deductions. Our tax estimator instantly computes your tax liability and take-home pay. All calculations run locally in your browser." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate tax on salary?",
      "acceptedAnswer": { "@type": "Answer", "text": "Enter your gross salary into the salary tax calculator along with allowances, bonuses, and deductions. The tool applies relevant PAYE, Social Security, and local tax rules for your country. Use the monthly calculator for detailed breakdowns of earnings after tax." }
    },
    {
      "@type": "Question",
      "name": "Can I use a tax calculator for multiple countries?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Finsiva supports income tax, salary tax, payroll tax, GST, VAT, and more across 10+ countries. Each calculator is tailored to the specific tax rules of the country you select, so you get accurate estimates for every jurisdiction." }
    },
    {
      "@type": "Question",
      "name": "Which is better: old tax regime or new tax regime?",
      "acceptedAnswer": { "@type": "Answer", "text": "The choice depends on your deductions and income level. Taxpayers with significant deductions like home loan interest, retirement contributions, and insurance often benefit from the old regime. Those with fewer deductions may prefer the new regime lower slab rates." }
    },
    {
      "@type": "Question",
      "name": "How do I legally reduce my tax using deductions?",
      "acceptedAnswer": { "@type": "Answer", "text": "Claim all eligible deductions and credits such as retirement contributions, mortgage interest, charitable donations, education expenses, and business costs. Our tax estimator shows how each deduction lowers your tax base and increases your take-home pay." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my net salary after tax?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our net salary calculator takes your gross salary and subtracts income tax, Social Security contributions, and other deductions to show your take-home pay. It provides a detailed breakdown of every deduction so you understand where your money goes." }
    },
    {
      "@type": "Question",
      "name": "Are online tax calculators secure and private?",
      "acceptedAnswer": { "@type": "Answer", "text": "Finsiva is built with privacy by design. All calculations run entirely in your browser. We do not collect, store, or transmit your income, deduction, or any financial data to any server. Your information stays on your device." }
    },
    {
      "@type": "Question",
      "name": "How often are tax rates updated on Finsiva?",
      "acceptedAnswer": { "@type": "Answer", "text": "We update our calculators whenever tax rules, slabs, thresholds, or regulations change. Our platform is actively maintained to reflect the latest official rates from government tax authorities across all supported countries." }
    },
      ]
    },
    {
      "@type": "Article",
      "headline": "Finsiva Tax Calculator -- Free Online Tax Estimator for Global Taxes",
      "description": "Use our free tax calculator to estimate income tax, salary tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free.",
      "url": baseUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": baseUrl },
      "author": { "@type": "Organization", "name": "Finsiva" },
      "publisher": { "@type": "Organization", "name": "Finsiva", "logo": { "@type": "ImageObject", "url": baseUrl + "/logo.png" } },
      "datePublished": "2025-01-01",
      "dateModified": "2026-01-01"
    }
  ]
};
---

<Layout
  title="Tax Calculator | Free Online Tax Estimator | Finsiva"
  description="Free tax calculator to estimate income tax, salary tax, and take-home pay. Accurate, privacy-first results for 10+ countries. Try Finsiva now."
  canonical={baseUrl}
  robots="index,follow"
  schema={homepageSchema}
  image="/og-image.svg"
  imageAlt="Finsiva tax calculator dashboard showing income tax estimates across multiple countries"
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 40%, #1E40AF 100%);" aria-hidden="true"></div>
      <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[400px] w-[600px] rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
         <span class="section-label !text-white">Trusted by millions worldwide</span>
        <h1 class="hero-title text-4xl font-extrabold tracking-tight text-white sm:text-5xl" style="line-height:1.05; max-width: 56rem; margin-left: auto; margin-right: auto;">Tax Calculator — Free, Accurate & Private</h1>
        <p class="hero-description mt-4 max-w-2xl mx-auto text-lg text-white/90 sm:text-xl" style="line-height:1.6;">
          Estimate income tax, salary tax, and take-home pay for any country in seconds. No registration, no data collection — just accurate, privacy-first results powered by official tax rules.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-6 sm:flex-row">
          <a href="/countries" class="hero-btn-primary inline-flex items-center justify-center gap-2 rounded-pill bg-[#111827] px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-black/20 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-[#1F2937] hover:shadow-xl hover:shadow-black/30 active:translate-y-0 active:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:ring-offset-2">Start Calculating Taxes</a>
          <a href="#how-it-works" class="hero-btn-secondary inline-flex items-center justify-center gap-2 rounded-pill border border-white/40 px-8 py-3.5 text-base font-semibold text-white transition-all duration-200 ease-out hover:bg-white/10 hover:border-white active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:ring-offset-2">See How It Works</a>
        </div>
      </div>
    </section>
    <section id="why-choose-finsiva" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="why-choose-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="why-choose-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Why Choose Finsiva</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h20" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">10+ Countries</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Income tax, salary tax, payroll, GST, VAT, and more across India, the US, the UK, Australia, Canada, Singapore, and beyond — all in one platform.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 12 2 2 4-4" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Privacy First</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Every calculation runs exclusively in your browser. Your financial data is never collected, stored, or transmitted to any server.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Instant Results</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Get detailed tax estimates in seconds with no registration, no waiting, and no complicated forms to fill out.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 3v5h-5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H3v5" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Always Updated</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Tax rules change every year. Our calculators reflect the latest official rates, thresholds, and regulations for every supported country.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="countries-supported" class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="countries-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="countries-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Countries Supported</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Explore tax calculators tailored to the rules of each country. Select your country to view income tax slabs, payroll deductions, GST, VAT, and more.</p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {countries.map(country => (
            <a href={`/countries/${country.slug}`} class="flex items-center gap-3 rounded-lg border border-hairline bg-canvas p-4 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary" aria-label={`View tax calculators for ${country.name}`}>
              <img src={country.flag} alt={`${country.name} flag`} width="32" height="24" loading="lazy" class="h-8 w-auto object-contain" title={country.name} />
              <span class="min-w-0 font-medium text-ink dark:text-on-primary">{country.name}</span>
            </a>
          ))}
        </div>
        <div class="mt-6">
          <a href="/countries" class="inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">View all countries</a>
        </div>
      </div>
    </section>
    <section id="popular-calculators" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="calculators-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="calculators-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Popular Tax Calculators</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Choose from a growing library of calculator categories. Each tool is designed around the tax structure of the country you select.</p>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Income Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate income tax across multiple countries with up-to-date slab rates, deductions, and filing status options.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Salary Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate tax on salary including allowances, bonuses, and employer contributions with detailed breakdowns.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Payroll Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate payroll taxes, employer contributions, and net pay for businesses and employees.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">GST Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate GST inclusive and exclusive amounts quickly and accurately for Indian businesses.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">VAT Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate VAT on domestic and cross-border transactions with support for multiple European rates.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Sales Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate sales tax on purchases for e-commerce, retail, and everyday transactions.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Capital Gains Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate capital gains tax on stocks, real estate, and other investments for short-term and long-term gains.</p>
          </a>
          <a href="/countries" class="card group dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Property Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate property tax, stamp duty, and related costs for residential and commercial real estate.</p>
          </a>
        </div>
      </div>
    </section>
    <section id="how-it-works" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="how-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="how-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">How It Works</h2>
        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&q=80" alt="Finance professional analyzing tax documents on a laptop" class="mx-auto mb-12 w-full max-w-3xl rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">1</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Choose Your Country</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Select the country whose tax rules apply to your situation. Each country has dedicated tax categories and calculators prepared for local requirements.</p>
          </div>
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">2</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Enter Your Details</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Provide your income, deductions, filing status, and other relevant details. No sensitive personal data is required — all inputs stay on your device.</p>
          </div>
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">3</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Review Your Estimate</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">See your tax liability, effective rate, and take-home pay instantly. Use the results to plan your finances or prepare for filing with confidence.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="why-millions-use" class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="millions-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="millions-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Why Millions Use Tax Calculators</h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Understand Your Tax Position</h3>
            <p class="mt-2 text-body dark:text-muted">Tax systems vary dramatically across countries. A tax calculator helps you understand how much of your income goes to taxes and what factors most affect your bill — whether you are a salaried employee, freelancer, or business owner.</p>
            <p class="mt-2 text-body dark:text-muted">Knowing your tax position before receiving a paycheck or signing a contract gives you a realistic picture of your financial future and helps you negotiate compensation with confidence.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Plan Deductions and Save</h3>
            <p class="mt-2 text-body dark:text-muted">Most taxpayers leave money on the table by missing deductions they are entitled to. A calculator helps you model different scenarios — adjusting income thresholds, claiming specific credits, or comparing old versus new regimes — so you can optimize your tax strategy.</p>
            <p class="mt-2 text-body dark:text-muted">Try different scenarios to see how retirement contributions, mortgage interest, or charitable giving lower your taxable income. This kind of proactive planning is impossible with paper-based estimation.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="key-features" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="features-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="features-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Features</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Instant Calculations</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Get results in milliseconds with optimized algorithms built for speed and accuracy.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Accurate Estimates</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Calculations based on official tax slabs, statutory rates, and regulatory guidelines from government sources.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Multiple Countries</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">One platform for income tax, GST, VAT, payroll, and more across different jurisdictions worldwide.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Multiple Tax Types</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">From income tax to capital gains, property tax to payroll — all calculator types in one place.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Easy to Use</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Clean interfaces with guided inputs so anyone can estimate their taxes in minutes.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Mobile Friendly</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Responsive design that works on desktop, tablet, and mobile without any app download.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Always Updated</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">We update our calculators whenever tax rules, slabs, or thresholds change in any supported country.</p>
          </div>
          <div class="card dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Secure & Private</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">No accounts, no tracking, no data collection. Your financial data stays entirely on your device.</p>
          </div>
        </div>
      </div>
    </section>
