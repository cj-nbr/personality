---
import Layout from "../layouts/Layout.astro";
import { countries } from "../data/countries";
import { getBaseUrl } from "../utils/routing";

const baseUrl = getBaseUrl();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": baseUrl
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much tax will I pay?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The amount of tax you pay depends on your total income, deductions, filing status, and the tax jurisdiction you fall under. Our tax estimator uses current tax slabs and rules to provide an accurate estimate based on your inputs. Simply select your country, enter your income details, and review the instant breakdown of your tax liability."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my tax liability?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate your tax liability, start with your total income from all sources such as salary, business income, investments, and freelance earnings. Subtract allowable deductions and exemptions to arrive at your taxable income. Then apply the relevant tax slab rates for your jurisdiction. Our income tax calculator automates this process using the latest official rates and rules."
      }
    },
    {
      "@type": "Question",
      "name": "What is an income tax calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An income tax calculator is an online tool that estimates how much tax you owe based on your income, deductions, and applicable tax laws. It helps you understand your take-home pay, effective tax rate, and potential refund amount. Finsiva supports multiple countries and tax types so you can get accurate estimates wherever you are."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate income tax online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Calculating income tax online is simple. Select your country, enter your annual income, choose your filing status and tax year, then input any applicable deductions. Our tax estimator instantly computes your tax liability, effective tax rate, and take-home pay. All calculations run locally in your browser, so your financial data never leaves your device."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate tax on salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate tax on salary, enter your gross annual or monthly salary into our salary tax calculator along with any allowances, bonuses, and deductions. The tool applies the relevant PAYE, Social Security, Medicare, and local tax rules for your country. Use the monthly or paycheck calculators to see detailed breakdowns of your earnings after tax."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use a tax calculator for advance tax payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our estimated tax payments calculator helps you calculate quarterly advance tax installments. Enter your projected annual income, existing withholding, and deductions to see your total estimated liability and the amount due each quarter. This is especially useful for self-employed individuals, freelancers, and investors who must make estimated payments."
      }
    },
    {
      "@type": "Question",
      "name": "What are the current income tax slab rates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Income tax slab rates vary by country, filing status, and tax year. Many countries use progressive systems with brackets ranging from 0% to 50% depending on income levels. Our income tax calculator automatically applies the correct slab rates for your selected jurisdiction, so you always get an accurate estimate without manually looking up tax tables."
      }
    },
    {
      "@type": "Question",
      "name": "Which is better: old tax regime or new tax regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The choice between old and new tax regimes depends on your total deductions and income level. Taxpayers with significant deductions such as home loan interest, retirement contributions, and insurance premiums often benefit from the old regime. Those with fewer deductions may prefer the new regime's lower slab rates. Use our old vs new tax regime calculator to compare both options."
      }
    },
    {
      "@type": "Question",
      "name": "How can I legally reduce my tax using deductions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can legally reduce your tax liability by claiming all eligible deductions and credits. Common deductions include retirement contributions, mortgage interest, charitable donations, education expenses, and business expenses. Our taxable income estimator shows exactly how each deduction lowers your tax base and increases your take-home pay."
      }
    },
    {
      "@type": "Question",
      "name": "What makes Finsiva one of the best tax calculators?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Finsiva stands out because it supports multiple countries and tax types in one place, performs calculations locally in your browser for complete privacy, and provides instant results without registration. Our tools are built for accuracy, updated regularly, and designed to be easy for beginners while powerful enough for professionals."
      }
    }
  ]
};
---

<Layout
  title="Tax Calculator - Free Online Tool for Global Taxes | Finsiva"
  description="Use our free tax calculator to estimate income tax, salary tax, payroll tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free."
  canonical={baseUrl}
  robots="index,follow"
  schema={breadcrumbSchema}
>
  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-canvas-soft to-canvas dark:from-primary dark:to-primary" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl dark:text-on-primary">Tax Calculator</h1>
        <p class="mt-4 max-w-3xl mx-auto text-lg text-body dark:text-muted">
          Free, accurate, and privacy-first tax calculators for individuals and businesses across multiple countries. Estimate income tax, salary tax, payroll tax, GST, VAT, and more.
        </p>
        <div class="mt-8 flex items-center justify-center gap-4">
          <a href="/countries" class="rounded-pill bg-primary px-6 py-3 text-base font-medium text-on-primary transition hover:opacity-90 dark:bg-on-primary dark:text-primary">Explore All Calculators</a>
          <a href="#how-it-works" class="rounded-pill border border-hairline px-6 py-3 text-base font-medium text-ink transition hover:bg-canvas-soft dark:border-overlay-lighter dark:text-on-primary dark:hover:overlay-light">How It Works</a>
        </div>
      </div>
    </section>

    <section id="why-choose-finsiva" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="why-choose-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="why-choose-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Why Choose Finsiva</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Multiple Countries</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Accurate tax calculations for over 10 countries including India, the US, the UK, Australia, Canada, and more.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Privacy First</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">All calculations run locally in your browser. No personal data is ever collected or transmitted.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Instant Results</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Get detailed tax estimates in seconds. No registration, no waiting, and no complicated forms.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 4.168 7.253v13C6.832 20.477 8.416 21 10 21h4c1.584 0 3.168-.523 3.168-2.253V7.253C14.832 5.477 13.246 5 11.5 5z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Always Updated</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Tax rules change. Our calculators are updated regularly to reflect the latest official rates and regulations.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="countries-supported" class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="countries-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="countries-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Countries Supported</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Explore tax calculators tailored to the rules of each country. Select your country to view income tax slabs, payroll deductions, GST, VAT, and more.</p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {countries.map(country => (
            <a href={`/countries/${country.slug}`} class="flex items-center gap-3 rounded-lg border border-hairline bg-canvas p-4 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
              <img src={country.flag} alt={country.name} width="32" height="24" loading="lazy" class="h-8 w-auto object-contain" />
              <span class="font-medium text-ink dark:text-on-primary">{country.name}</span>
            </a>
          ))}
        </div>
        <div class="mt-6">
          <a href="/countries" class="inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">View all countries</a>
        </div>
      </div>
    </section>

    <section id="popular-calculators" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="calculators-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="calculators-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Popular Tax Calculators</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Choose from a growing library of calculator categories. Each tool is designed around the specific tax structure of the country you select.</p>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/income-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Income Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate federal, state, and local income tax across multiple countries with up-to-date slab rates.</p>
          </a>
          <a href="/salary-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Salary Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate tax on salary including allowances, bonuses, and employer contributions with detailed breakdowns.</p>
          </a>
          <a href="/payroll-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Payroll Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate payroll taxes, employer contributions, and net pay for businesses and employees.</p>
          </a>
          <a href="/gst-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">GST Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate GST inclusive and exclusive amounts quickly and accurately.</p>
          </a>
          <a href="/vat-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">VAT Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate VAT on domestic and cross-border transactions with support for multiple rates.</p>
          </a>
          <a href="/sales-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Sales Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Calculate sales tax on purchases for e-commerce, retail, and everyday transactions.</p>
          </a>
          <a href="/capital-gains-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Capital Gains Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate capital gains tax on stocks, real estate, and other investments for short-term and long-term gains.</p>
          </a>
          <a href="/property-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Property Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate property tax, stamp duty, and related costs for residential and commercial real estate.</p>
          </a>
          <a href="/corporate-tax-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Corporate Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate corporate tax liability for businesses including small business and multinational entities.</p>
          </a>
          <a href="/tax-refund-calculator" class="group rounded-xl border border-hairline bg-canvas p-6 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Tax Refund Calculator</h3>
            <p class="text-sm text-body dark:text-muted">Estimate your tax refund based on income, withholding, deductions, and credits.</p>
          </a>
        </div>
      </div>
    </section>

    <section id="key-features" class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="features-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="features-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Key Features</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Fast Tax Calculations</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Get instant results with optimized algorithms built for speed and accuracy.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Accurate Estimates</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Calculations based on official tax slabs, statutory rates, and regulatory guidelines.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Multiple Countries</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">One platform for income tax, GST, VAT, payroll, and more across different jurisdictions.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Multiple Tax Types</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">From income tax to corporate tax, capital gains to property tax, all in one place.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Easy to Use</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Clean interfaces with guided inputs so you can estimate your taxes in minutes.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Mobile Friendly</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Responsive design that works on desktop, tablet, and mobile without any app download.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Always Updated</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">We update our calculators whenever tax rules, slabs, or thresholds change.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-semibold text-ink dark:text-on-primary">Secure & Private</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">No accounts, no tracking, no data collection. Your financial data stays on your device.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="border-t border-hairline dark:border-overlay-light" aria-labelledby="how-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="how-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">How It Works</h2>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">1</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Choose Your Country</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Select the country whose tax rules apply to your situation. Each country has dedicated tax categories and calculators.</p>
          </div>
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">2</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Enter Your Details</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Provide your income, deductions, filing status, and any other relevant details. No sensitive personal data is required.</p>
          </div>
          <div class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-hairline bg-canvas text-lg font-bold text-ink dark:border-overlay-lighter dark:bg-surface dark:text-on-primary" aria-hidden="true">3</span>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Review Your Estimate</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">See your tax liability, effective rate, and take-home pay instantly. Use the results to plan your finances or prepare for filing.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="benefits" class="border-t border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas" aria-labelledby="benefits-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="benefits-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Benefits</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <h3 class="font-semibold text-ink dark:text-on-primary">Save Time</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Automate complex tax computations with instant, accurate results instead of manual spreadsheets.</p>
          </div>
          <div>
            <h3 class="font-semibold text-ink dark:text-on-primary">Reduce Errors</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Built-in logic follows official rules so you avoid common calculation mistakes during tax planning.</p>
          </div>
          <div>
            <h3 class="font-semibold text-ink dark:text-on-primary">Compare Scenarios</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Test different incomes, deductions, and regimes to make informed financial decisions.</p>
          </div>
          <div>
            <h3 class="font-semibold text-ink dark:text-on-primary">Plan Ahead</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Use quarterly and annual estimates to forecast payments and avoid surprises at tax time.</p>
          </div>
          <div>
            <h3 class="font-semibold text-ink dark:text-on-primary">Understand Your Taxes</h3>
