---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  canonical?: string;
  schema?: Record<string, unknown>;
  image?: string;
  imageAlt?: string;
  keywords?: string;
  robots?: string;
  howToSchema?: Record<string, unknown>;
  itemListSchema?: Record<string, unknown>;
}

const { title, description, breadcrumbs, canonical, schema, image, imageAlt, keywords, robots, howToSchema, itemListSchema } = Astro.props;
---

<Layout
  title={`${title} | Finsiva`}
  description={description}
  image={image}
  imageAlt={imageAlt}
  keywords={keywords}
  canonical={canonical}
  robots={robots}
  schema={schema}
  howToSchema={howToSchema}
  itemListSchema={itemListSchema}
>
  {breadcrumbs && breadcrumbs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Countries",
        "item": "https://finsiva.com/countries/"
      }]
    })} slot="head" />
  )}
  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <div class="min-h-screen">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
        <slot />
      </div>
    </div>
  </div>
</Layout>
