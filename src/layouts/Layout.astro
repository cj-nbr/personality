---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import { loadLocales, setLang, getLang, getDict, detectLanguage } from "../i18n";
import en from "../i18n/translations/en.json";
import hi from "../i18n/translations/hi.json";
import es from "../i18n/translations/es.json";
import fr from "../i18n/translations/fr.json";
import de from "../i18n/translations/de.json";
import zh from "../i18n/translations/zh.json";
import zhTW from "../i18n/translations/zh-TW.json";
import ja from "../i18n/translations/ja.json";
import ar from "../i18n/translations/ar.json";
import pt from "../i18n/translations/pt.json";
import ru from "../i18n/translations/ru.json";

loadLocales({ en, hi, es, fr, de, zh, "zh-TW": zhTW, ja, ar, pt, ru });

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  schema?: Record<string, unknown>;
  howToSchema?: Record<string, unknown>;
  itemListSchema?: Record<string, unknown>;
}

const {
  title = "Tax Calculator - Free Online Tool for Global Taxes | Finsiva",
  description = "Use our free tax calculator to estimate income tax, salary tax, payroll tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free.",
  image = "/og-image.svg",
  imageAlt = "Finsiva tax calculator dashboard showing income tax estimates across multiple countries",
  keywords = "tax calculator, universal tax calculator, income tax calculator, salary tax calculator, online tax calculator, tax estimator, tax calculation tool, free tax calculator, tax refund calculator, global tax calculator, tax calculator online, net salary calculator, personal income tax calculator",
  canonical,
  robots = "index,follow",
  schema,
  howToSchema,
  itemListSchema
} = Astro.props;
const initialLang = detectLanguage();
setLang(initialLang);
const initialDir = initialLang === 'ar' ? 'rtl' : 'auto';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Finsiva",
  "url": "https://finsiva.com",
  "description": "Universal tax calculator platform for accurate tax estimates across multiple countries",
  "logo": "https://finsiva.com/logo.png",
  "sameAs": [
    "https://twitter.com/finsiva",
    "https://linkedin.com/company/finsiva"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "ornacasa11@gmail.com",
    "contactType": "customer support"
  }
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Finsiva",
  "url": "https://finsiva.com",
  "description": "Universal tax calculator platform for accurate tax estimates across multiple countries",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://finsiva.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Finsiva Tax Calculator",
  "url": "https://finsiva.com",
  "description": "Free online tax calculator for income tax, salary tax, payroll tax, GST, VAT, and more across multiple countries.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": 0,
    "priceCurrency": "USD"
  },
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "potentialAction": {
    "@type": "CalculateAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://finsiva.com/countries/{Country}/{TaxType}"
    },
    "object": {
      "@type": "Thing",
      "name": "Tax Calculation"
    }
  }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Finsiva - Universal Tax Calculator",
  "description": "Free online tax calculator for income tax, salary tax, payroll tax, GST, VAT, and more across multiple countries.",
  "url": "https://finsiva.com",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Finsiva",
    "url": "https://finsiva.com"
  },
  "about": {
    "@type": "SoftwareApplication",
    "name": "Finsiva Tax Calculator",
    "applicationCategory": "FinanceApplication"
  }
};
---

<!doctype html>
<html lang={initialLang} dir={initialDir} class="dark:bg-surface" color-scheme="light dark">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KGQ9X41EPQ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KGQ9X41EPQ');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="author" content="Finsiva" />
    <meta name="application-name" content="Finsiva Tax Calculator" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="canonical" href={canonical || new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <meta property="og:url" content={canonical || new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image || "/og-image.svg"} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Finsiva" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:domain" content="finsiva.com" />
    <link rel="alternate" hreflang="en-US" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="en-GB" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="hi-IN" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="de" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="zh-TW" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ar" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="pt" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ru" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@finsiva" />
    <meta name="twitter:creator" content="@finsiva" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image || "/og-image.svg"} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
      {schema && JSON.stringify(schema) !== '{}' && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )}
      {howToSchema && JSON.stringify(howToSchema) !== '{}' && (
        <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
      )}
      {itemListSchema && JSON.stringify(itemListSchema) !== '{}' && (
        <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
      )}
       <title>{title}</title>
       <slot name="head" />
     </head>
  <body class="min-h-screen bg-canvas text-ink antialiased dark:bg-surface dark:text-on-primary">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary focus:ring-2 focus:ring-primary focus:ring-offset-2">Skip to main content</a>
    <SearchModal />
    <Header />
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>
    <footer class="border-t border-hairline bg-canvas dark:border-overlay-light dark:bg-surface">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="space-y-4">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink dark:text-on-primary">Popular Calculators</h3>
            <ul class="space-y-2">
              <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">Income Tax Calculator</a></li>
              <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">Salary Tax Calculator</a></li>
              <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">Payroll Tax Calculator</a></li>
              <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">GST Calculator</a></li>
              <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">VAT Calculator</a></li>
            </ul>
          </div>
          <div class="space-y-4">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink dark:text-on-primary">Popular Countries</h3>
            <ul class="space-y-2">
              <li><a href="/countries/india" class="text-sm text-link hover:underline dark:text-link">India Tax</a></li>
              <li><a href="/countries/united-states" class="text-sm text-link hover:underline dark:text-link">United States Tax</a></li>
              <li><a href="/countries/united-kingdom" class="text-sm text-link hover:underline dark:text-link">UK Tax</a></li>
              <li><a href="/countries/hong-kong" class="text-sm text-link hover:underline dark:text-link">Hong Kong Tax</a></li>
              <li><a href="/countries/singapore" class="text-sm text-link hover:underline dark:text-link">Singapore Tax</a></li>
            </ul>
          </div>
          <div class="space-y-4">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink dark:text-on-primary">Resources</h3>
              <ul class="space-y-2">
                <li><a href="/blogs" class="text-sm text-link hover:underline dark:text-link">Tax Guides</a></li>
                <li><a href="/knowledge" class="text-sm text-link hover:underline dark:text-link">Knowledge Center</a></li>
                <li><a href="/knowledge/glossary" class="text-sm text-link hover:underline dark:text-link">Tax Glossary</a></li>
                <li><a href="/countries" class="text-sm text-link hover:underline dark:text-link">Tax Slabs & Rates</a></li>
              </ul>
          </div>
          <div class="space-y-4">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink dark:text-on-primary">Company</h3>
            <ul class="space-y-2">
              <li><a href="/about" class="text-sm text-link hover:underline dark:text-link">About Us</a></li>
              <li><a href="/contact" class="text-sm text-link hover:underline dark:text-link">Contact</a></li>
              <li><a href="/privacy" class="text-sm text-link hover:underline dark:text-link">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-link hover:underline dark:text-link">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-8 border-t border-hairline dark:border-overlay-light">
          <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-sm font-semibold text-ink dark:text-on-primary" translate="no">Finsiva</span>
            </div>
            <p class="text-xs text-muted dark:text-muted" data-i18n="footer.disclaimer">Tax calculators for informational purposes only. Consult a tax professional for advice.</p>
            <p class="text-xs text-muted dark:text-muted">&copy; {new Date().getFullYear()} Finsiva. All rights reserved.</p>
          </div>
        </div>
      </div>
    </footer>

    <script type="module">
      import { loadLocales, setLang, getLang, getDict } from "/src/i18n/client.ts";
      import en from "/src/i18n/translations/en.json";
      import hi from "/src/i18n/translations/hi.json";
      import es from "/src/i18n/translations/es.json";
      import fr from "/src/i18n/translations/fr.json";
      import de from "/src/i18n/translations/de.json";
      import zh from "/src/i18n/translations/zh.json";
      import zhTW from "/src/i18n/translations/zh-TW.json";
      import ja from "/src/i18n/translations/ja.json";
      import ar from "/src/i18n/translations/ar.json";
      import pt from "/src/i18n/translations/pt.json";
      import ru from "/src/i18n/translations/ru.json";
      loadLocales({ en, hi, es, fr, de, zh, "zh-TW": zhTW, ja, ar, pt, ru });

      const dict = getDict();
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!key) return;
        const text = dict[key];
        if (text) {
          let final = text;
          const varsAttr = el.getAttribute('data-i18n-vars');
          if (varsAttr) {
            try {
              const vars = JSON.parse(varsAttr);
              final = final.replace(/\{(\w+)\}/g, (_, k) => (vars[k] !== undefined ? String(vars[k]) : _));
            } catch {}
          }
          el.textContent = final;
        }
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (!key) return;
        const text = dict[key];
        if (text) el.setAttribute('placeholder', text);
      });

      document.querySelectorAll('[data-i18n-title]').forEach((el) => {
        const key = el.getAttribute('data-i18n-title');
        if (!key) return;
        const text = dict[key];
        if (text) el.setAttribute('title', text);
      });

      window.addEventListener("lang-change", () => {
        const newDict = getDict();
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const text = newDict[key];
          if (text) {
            let final = text;
            const varsAttr = el.getAttribute('data-i18n-vars');
            if (varsAttr) {
              try {
                const vars = JSON.parse(varsAttr);
                final = final.replace(/\{(\w+)\}/g, (_, k) => (vars[k] !== undefined ? String(vars[k]) : _));
              } catch {}
            }
            el.textContent = final;
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (!key) return;
          const text = newDict[key];
          if (text) el.setAttribute('placeholder', text);
        });
        document.querySelectorAll('[data-i18n-title]').forEach((el) => {
          const key = el.getAttribute('data-i18n-title');
          if (!key) return;
          const text = newDict[key];
          if (text) el.setAttribute('title', text);
        });
        const event = new CustomEvent("i18n-updated", { bubbles: true });
        document.documentElement.dispatchEvent(event);
      });

      document.documentElement.addEventListener("lang-change", (e) => {
        const lang = (e as CustomEvent).detail?.lang || getLang();
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
        const nodes: Text[] = [];
        let node: Text | null;
        while ((node = walker.nextNode() as Text | null)) nodes.push(node);
        nodes.forEach((textNode) => {
          let text = textNode.textContent || "";
          let changed = false;
          let newText = text;
          const cDict = countryNames[lang] || countryNames.en;
          const catDict = categoryNames[lang] || categoryNames.en;
          for (const [enName, translated] of Object.entries(cDict)) {
            if (newText.includes(enName)) {
              newText = newText.replace(new RegExp(enName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), translated);
              changed = true;
            }
          }
          for (const [enName, translated] of Object.entries(catDict)) {
            if (newText.includes(enName)) {
              newText = newText.replace(new RegExp(enName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), translated);
              changed = true;
            }
          }
          if (changed && textNode.parentElement) {
            textNode.textContent = newText;
          }
        });
      });
    </script>
  </body>
</html>
