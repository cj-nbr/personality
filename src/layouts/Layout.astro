---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { loadLocales, setLang, getLang, getDict, detectLanguage } from "../i18n";
import en from "../i18n/translations/en.json";
import hi from "../i18n/translations/hi.json";
import es from "../i18n/translations/es.json";
import fr from "../i18n/translations/fr.json";
import de from "../i18n/translations/de.json";
import zh from "../i18n/translations/zh.json";
import zhTW from "../i18n/translations/zh-TW.json";
import ja from "../i18n/translations/ja.json";
import ar from "../i18n/translations/ar.json";
import pt from "../i18n/translations/pt.json";
import ru from "../i18n/translations/ru.json";

loadLocales({ en, hi, es, fr, de, zh, "zh-TW": zhTW, ja, ar, pt, ru });

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  schema?: Record<string, unknown>;
}

const {
  title = "Tax Calculator - Free Online Tool for Global Taxes | Finsiva",
  description = "Use our free tax calculator to estimate income tax, salary tax, payroll tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free.",
  image = "https://finsiva.com/og-image.png",
  keywords = "tax calculator, universal tax calculator, income tax calculator, salary tax calculator, online tax calculator, tax estimator, tax calculation tool, free tax calculator, tax refund calculator, global tax calculator, tax calculator online, net salary calculator, personal income tax calculator",
  canonical,
  robots = "index,follow",
  schema
} = Astro.props;
const initialLang = detectLanguage();
setLang(initialLang);
const initialDir = initialLang === 'ar' ? 'rtl' : 'auto';
---

<!doctype html>
<html lang={initialLang} dir={initialDir} class="dark:bg-surface" color-scheme="light dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical || new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:url" content={canonical || new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image || "https://finsiva.com/og-image.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Finsiva" />
    <meta property="og:locale" content="en_US" />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="hi" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="de" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="zh" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="zh-TW" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ar" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="pt" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="ru" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image || "https://finsiva.com/og-image.png"} />
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "Finsiva",
          "url": "https://finsiva.com",
          "description": "Universal tax calculator platform for accurate tax estimates across multiple countries",
          "logo": "https://finsiva.com/logo.png",
          "sameAs": [
            "https://twitter.com/finsiva",
            "https://linkedin.com/company/finsiva"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "support@finsiva.com",
            "contactType": "customer support"
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "Finsiva",
          "url": "https://finsiva.com",
          "description": "Universal tax calculator platform for accurate tax estimates across multiple countries",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://finsiva.com/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebApplication",
          "name": "Finsiva Tax Calculator",
          "url": "https://finsiva.com",
          "description": "Free online tax calculator for income tax, salary tax, payroll tax, GST, VAT, and more across multiple countries.",
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "Web",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "browserRequirements": "Requires JavaScript. Requires HTML5."
        }
      </script>
      {schema && JSON.stringify(schema) !== '{}' && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )}
      <title>{title}</title>
      <slot name="head" />
    </head>
  <body class="min-h-screen bg-canvas text-ink antialiased dark:bg-surface dark:text-on-primary">
    <Header />
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>
    <footer class="border-t border-hairline bg-canvas py-12 dark:border-overlay-light dark:bg-surface">
      <div class="mx-auto max-w-7xl px-4 text-center text-sm text-muted sm:px-6 lg:px-8 dark:text-muted">
        <nav class="flex flex-wrap items-center justify-center gap-6 mb-6">
          <a href="/about" class="text-link hover:underline dark:text-link">About</a>
          <a href="/editorial-policy" class="text-link hover:underline dark:text-link">Editorial Policy</a>
          <a href="/contact" class="text-link hover:underline dark:text-link">Contact us</a>
          <a href="/privacy" class="text-link hover:underline dark:text-link">Privacy Policy</a>
          <a href="/terms" class="text-link hover:underline dark:text-link">Terms</a>
        </nav>
        <p data-i18n="footer.disclaimer">Finsiva. For informational purposes only. Consult a tax professional for advice.</p>
        <p class="mt-2">&copy; {new Date().getFullYear()} Finsiva</p>
      </div>
    </footer>

    <script type="module">
      import { loadLocales, setLang, getLang, getDict } from "/src/i18n/client.ts";
      import en from "/src/i18n/translations/en.json";
      import hi from "/src/i18n/translations/hi.json";
      import es from "/src/i18n/translations/es.json";
      import fr from "/src/i18n/translations/fr.json";
      import de from "/src/i18n/translations/de.json";
      import zh from "/src/i18n/translations/zh.json";
      import zhTW from "/src/i18n/translations/zh-TW.json";
      import ja from "/src/i18n/translations/ja.json";
      import ar from "/src/i18n/translations/ar.json";
      import pt from "/src/i18n/translations/pt.json";
      import ru from "/src/i18n/translations/ru.json";
      loadLocales({ en, hi, es, fr, de, zh, "zh-TW": zhTW, ja, ar, pt, ru });

      const dict = getDict();
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!key) return;
        const text = dict[key];
        if (text) {
          let final = text;
          const varsAttr = el.getAttribute('data-i18n-vars');
          if (varsAttr) {
            try {
              const vars = JSON.parse(varsAttr);
              final = final.replace(/\{(\w+)\}/g, (_, k) => (vars[k] !== undefined ? String(vars[k]) : _));
            } catch {}
          }
          el.textContent = final;
        }
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (!key) return;
        const text = dict[key];
        if (text) el.setAttribute('placeholder', text);
      });

      document.querySelectorAll('[data-i18n-title]').forEach((el) => {
        const key = el.getAttribute('data-i18n-title');
        if (!key) return;
        const text = dict[key];
        if (text) el.setAttribute('title', text);
      });

      window.addEventListener("lang-change", () => {
        const newDict = getDict();
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const text = newDict[key];
          if (text) {
            let final = text;
            const varsAttr = el.getAttribute('data-i18n-vars');
            if (varsAttr) {
              try {
                const vars = JSON.parse(varsAttr);
                final = final.replace(/\{(\w+)\}/g, (_, k) => (vars[k] !== undefined ? String(vars[k]) : _));
              } catch {}
            }
            el.textContent = final;
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (!key) return;
          const text = newDict[key];
          if (text) el.setAttribute('placeholder', text);
        });
        document.querySelectorAll('[data-i18n-title]').forEach((el) => {
          const key = el.getAttribute('data-i18n-title');
          if (!key) return;
          const text = newDict[key];
          if (text) el.setAttribute('title', text);
        });
        const event = new CustomEvent("i18n-updated", { bubbles: true });
        document.documentElement.dispatchEvent(event);
      });

      document.documentElement.addEventListener("lang-change", (e) => {
        const lang = (e as CustomEvent).detail?.lang || getLang();
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
        const nodes: Text[] = [];
        let node: Text | null;
        while ((node = walker.nextNode() as Text | null)) nodes.push(node);
        nodes.forEach((textNode) => {
          let text = textNode.textContent || "";
          let changed = false;
          let newText = text;
          const cDict = countryNames[lang] || countryNames.en;
          const catDict = categoryNames[lang] || categoryNames.en;
          for (const [enName, translated] of Object.entries(cDict)) {
            if (newText.includes(enName)) {
              newText = newText.replace(new RegExp(enName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), translated);
              changed = true;
            }
          }
          for (const [enName, translated] of Object.entries(catDict)) {
            if (newText.includes(enName)) {
              newText = newText.replace(new RegExp(enName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), translated);
              changed = true;
            }
          }
          if (changed && textNode.parentElement) {
            textNode.textContent = newText;
          }
        });
      });
    </script>
  </body>
</html>
