{
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node -e \"const fs=require('fs'); fs.copyFileSync('dist/sitemap-0.xml','dist/sitemap.xml'); let idx=fs.readFileSync('dist/sitemap-index.xml','utf8'); idx=idx.replace(/sitemap-0\\.xml/g,'sitemap.xml'); fs.writeFileSync('dist/sitemap-index.xml',idx);\"",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
